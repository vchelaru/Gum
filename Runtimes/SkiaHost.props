<Project>
  <!--
    Compile symbols shared by SkiaGum and the hosts built on it. SKIA selects the Skia render
    aliases (Texture2D=SKBitmap, Color=SKColor) in the shared source. A host sets
    GumSkiaHostSymbol (SILK, STRIDE, UNITY) before importing this to add the symbol that selects
    its own input host; SkiaGum leaves it empty.
  -->
  <PropertyGroup>
    <_GumSkiaSymbols>TRACE;SKIA</_GumSkiaSymbols>
    <_GumSkiaSymbols Condition="'$(GumSkiaHostSymbol)' != ''">$(_GumSkiaSymbols);$(GumSkiaHostSymbol)</_GumSkiaSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(_GumSkiaSymbols);FULL_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(_GumSkiaSymbols);FULL_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release_No_Diagnostics|AnyCPU'">
    <DefineConstants>$(_GumSkiaSymbols)</DefineConstants>
  </PropertyGroup>
</Project>
