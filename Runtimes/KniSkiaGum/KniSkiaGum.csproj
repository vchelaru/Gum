<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Gum.KniSkia: a KNI desktop host that renders Gum through SkiaGum. GumService owns the Skia
		render target (a SkiaGameRendering SkiaRenderTarget2D) and draws and composites it in Draw();
		this project reads KNI's mouse, keyboard and gamepad. It is the fourth
		interactive Skia host, modeled on SilkNetGum: it references SkiaGum for the render and Forms
		source, and imports SkiaInputHost.props for the shared cursor and GumService halves.

		It deliberately does NOT define KNI or XNALIKE: those symbols switch the shared Cursor.cs to
		XNA types and cannot be compiled next to SkiaGum. The KNI types appear only inside this
		project's own Cursor/Keyboard/GumService files, fully qualified or aliased.
	-->
	<Import Project="..\RuntimePackage.props" />

	<PropertyGroup>
		<PackageId>Gum.KniSkia</PackageId>
		<Version>2026.4.5.1</Version>
		<NoWarn>1591</NoWarn>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<GumSkiaHostSymbol>KNISKIA</GumSkiaHostSymbol>
	</PropertyGroup>

	<Import Project="..\SkiaHost.props" />
	<Import Project="..\SkiaInputHost.props" />
	<Import Project="..\SkiaPackages.props" />

	<!-- Gum.Color compiles into Gum.XnaCompat here, not Gum: with using Gum; and the KNI usings, Color would otherwise be ambiguous (CS0104) in every existing game file. -->
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);GUM_COLOR_OPT_IN</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<!-- Same KNI version as the samples and the SkiaGameRendering.Kni.DesktopGL package below, which pins it. Compile-time only: the game brings its own KNI platform package. -->
		<PackageReference Include="nkast.Xna.Framework" Version="4.3.9001" PrivateAssets="All" />
		<PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.3.9001" PrivateAssets="All" />
		<PackageReference Include="nkast.Xna.Framework.Input" Version="4.3.9001" PrivateAssets="All" />
		<PackageReference Include="nkast.Xna.Framework.Game" Version="4.3.9001" PrivateAssets="All" />
		<PackageReference Include="TextCopy" Version="6.2.1" />
		<!-- The render target GumService owns. DesktopGL is the supported KNI platform; the package flows
		     to the game, which therefore references no SkiaGameRendering package itself. -->
		<PackageReference Include="SkiaGameRendering.Kni.DesktopGL" Version="0.19.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- Gum.Color, the XNA-compatible color docs snippets use. Games alias it (using Color = Gum.Color;) because KNI has its own Color; Color.Kni.cs converts it to KNI's. -->
		<Compile Include="..\SkiaHost\Color.cs" Link="Color.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- The TextCopy clipboard is XNA-free, so it is shared by link instead of copied. -->
		<Compile Include="..\..\MonoGameGum\Clipboard\MonoGameGumClipboard.cs" Link="Clipboard\MonoGameGumClipboard.cs" />
		<Compile Include="..\..\MonoGameGum\Clipboard\ClipboardImplementation.cs" Link="Clipboard\ClipboardImplementation.cs" />
		<!-- KniGum's XNA keyboard types, shared by link so the KNI Skia Keyboard mirrors KniGum's API. -->
		<Compile Include="..\..\MonoGameGum\Input\KeyboardStateProcessor.cs" Link="Input\KeyboardStateProcessor.cs" />
		<Compile Include="..\..\MonoGameGum\Input\IInputReceiverKeyboardMonoGame.cs" Link="Input\IInputReceiverKeyboardMonoGame.cs" />
		<Compile Include="..\..\MonoGameGum\Input\XnaKeyboardExtensions.cs" Link="Input\XnaKeyboardExtensions.cs" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\SkiaGum\SkiaGum.csproj" />
	</ItemGroup>

	<Import Project="..\RuntimePackage.Analyzers.props" />

	<ItemGroup>
		<None Include="build\Gum.KniSkia.targets" Pack="true" PackagePath="buildTransitive\Gum.KniSkia.targets" Visible="false" />
	</ItemGroup>

</Project>
