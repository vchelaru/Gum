<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Gum.Brutal.OGL: an input host over BRUTAL's GLFW window (Ahwoo.Brutal.Glfw) that renders through
		SkiaGum into an OpenGL 3.3 texture (SkiaGameRendering.Brutal.OGL) and blits it to the window.
		The game calls GumService.Default.Initialize(window), Update and Draw and never touches Skia.
		Gum.Brutal.Vulkan (Runtimes/BrutalGum.Vulkan) is the Vulkan twin built from the same shared
		source (BrutalHost.props).
	-->
	<Import Project="..\RuntimePackage.props" />

	<PropertyGroup>
		<PackageId>Gum.Brutal.OGL</PackageId>
		<Version>2026.11.1</Version>
		<NoWarn>1591</NoWarn>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Ahwoo.Brutal.* ship net10.0 only. -->
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<GumSkiaHostSymbol>BRUTAL</GumSkiaHostSymbol>
	</PropertyGroup>

	<Import Project="..\BrutalHost.props" />

	<ItemGroup>
		<PackageReference Include="Ahwoo.Brutal.Glfw" Version="2026.10.5" />
		<!-- Skia on OpenGL. Never reference SkiaGameRendering.Brutal (Vulkan) here: both declare SkiaRenderTarget2D. -->
		<PackageReference Include="SkiaGameRendering.Brutal.OGL" Version="0.22.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\SkiaGum\SkiaGum.csproj" />
	</ItemGroup>

	<Import Project="..\RuntimePackage.Analyzers.props" />

	<!-- Guards against a consumer whose AssemblyName collides with BrutalGum.OGL. See #4311. -->
	<ItemGroup>
		<None Include="build\Gum.Brutal.OGL.targets" Pack="true" PackagePath="buildTransitive\Gum.Brutal.OGL.targets" Visible="false" />
	</ItemGroup>

</Project>
