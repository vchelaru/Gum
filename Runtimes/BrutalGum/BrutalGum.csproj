<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Gum.Brutal: an input host over BRUTAL's GLFW window (Ahwoo.Brutal.Glfw) that renders through
		SkiaGum. BRUTAL ships Vulkan and GLFW bindings and no renderer, so Gum draws into the canvas of a
		SkiaGameRendering.Brutal SkiaRenderTarget2D that the game owns, and the game samples that Vulkan
		image in its own renderer. This package therefore references neither SkiaGameRendering nor
		Vulkan: the game passes the canvas to GumService.Draw(SKCanvas) each frame.
	-->
	<Import Project="..\RuntimePackage.props" />

	<PropertyGroup>
		<PackageId>Gum.Brutal</PackageId>
		<Version>2026.11.1</Version>
		<NoWarn>1591</NoWarn>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Ahwoo.Brutal.* ship net10.0 only. -->
		<TargetFramework>net10.0</TargetFramework>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup>
		<GumSkiaHostSymbol>BRUTAL</GumSkiaHostSymbol>
	</PropertyGroup>

	<Import Project="..\SkiaHost.props" />
	<Import Project="..\SkiaInputHost.props" />
	<Import Project="..\SkiaPackages.props" />

	<ItemGroup>
		<!-- Windowing and input. GLFW is the window BRUTAL's own Vulkan demos use. -->
		<PackageReference Include="Ahwoo.Brutal.Glfw" Version="2026.10.5" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\SkiaGum\SkiaGum.csproj" />
	</ItemGroup>

	<Import Project="..\RuntimePackage.Analyzers.props" />

	<!-- Guards against a consumer whose AssemblyName collides with BrutalGum. See #4311. -->
	<ItemGroup>
		<None Include="build\Gum.Brutal.targets" Pack="true" PackagePath="buildTransitive\Gum.Brutal.targets" Visible="false" />
	</ItemGroup>

</Project>
