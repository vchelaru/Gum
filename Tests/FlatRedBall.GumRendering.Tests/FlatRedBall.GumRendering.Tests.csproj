<Project Sdk="Microsoft.NET.Sdk">

	<!-- OPT-IN ONLY. Renders Gum through a real FlatRedBall (FRB1) game and compares pixels against
	     golden PNGs. Needs a FlatRedBall checkout beside this repo (../FlatRedBall, branch
	     NetStandard). Not part of any solution; run it by path:
	         dotnet test Tests/FlatRedBall.GumRendering.Tests
	     Set UPDATE_GOLDENS=1 to rewrite the goldens. Skips itself with a warning when the sibling
	     checkout is missing. -->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RollForward>Major</RollForward>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- The linked MainThreadTestHost.cs owns Main so MonoGame runs on the process main thread. -->
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<FrbRoot>$(MSBuildThisFileDirectory)..\..\..\FlatRedBall\</FrbRoot>
		<HasFrb Condition="Exists('$(FrbRoot)Engines\FlatRedBallXNA\FlatRedBallDesktopGLNet6\FlatRedBallDesktopGLNet6.csproj')">true</HasFrb>
	</PropertyGroup>

	<ItemGroup Condition="'$(HasFrb)' == 'true'">
		<PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="17.14.1" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5" />
		<PackageReference Include="MonoGame.Framework.DesktopGL" VersionOverride="3.8.4.1" />
		<ProjectReference Include="..\..\GumCore\GumCoreXnaPc\GumCore.DesktopGlNet6\GumCore.DesktopGlNet6.csproj" />
		<Compile Include="..\MonoGameGum.IntegrationTests\MainThreadTestHost.cs" Link="MainThreadTestHost.cs" />
		<None Update="Content\Shader.xnb" CopyToOutputDirectory="PreserveNewest" />
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup Condition="'$(HasFrb)' != 'true'">
		<Compile Remove="**\*.cs" />
	</ItemGroup>

	<Target Name="WarnNoFrb" BeforeTargets="Build" Condition="'$(HasFrb)' != 'true'">
		<Warning Text="FlatRedBall checkout not found at $(FrbRoot); FlatRedBall.GumRendering.Tests skipped." />
	</Target>

</Project>
