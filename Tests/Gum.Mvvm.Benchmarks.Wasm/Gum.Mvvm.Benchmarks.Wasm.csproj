<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!--
    Browser (Blazor WebAssembly) host for the Gum.Mvvm.Benchmarks cases (#6356). Not in any solution, so CI never builds it.
    Build and measure it in Debug on purpose: that is the interpreter (no AOT, no JIT), which is how a default Blazor app
    runs. Needs no wasm-tools workload.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gum.Mvvm.Benchmarks.Wasm</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <!-- Plain files only, so any static server can host the output. -->
    <CompressionEnabled>false</CompressionEnabled>
    <!-- Trimming could drop the reflection-discovered [DependsOn] properties and would change what is measured. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
  </ItemGroup>

  <!-- The same model classes, accessors and loops as the desktop benchmark. -->
  <ItemGroup>
    <Compile Include="..\Gum.Mvvm.Benchmarks\Accessors.cs" Link="Shared\Accessors.cs" />
    <Compile Include="..\Gum.Mvvm.Benchmarks\BenchModels.cs" Link="Shared\BenchModels.cs" />
    <Compile Include="..\Gum.Mvvm.Benchmarks\RefModels.cs" Link="Shared\RefModels.cs" />
    <Compile Include="..\Gum.Mvvm.Benchmarks\Harness.cs" Link="Shared\Harness.cs" />
  </ItemGroup>

</Project>
