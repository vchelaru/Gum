<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);SKIA_LINKED_TESTS</DefineConstants>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="AutoFixture.AutoMoq" />
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Moq" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit" />
		<PackageReference Include="xunit.runner.visualstudio" />
	</ItemGroup>
	<ItemGroup>
	  <!-- Was SkiaGum.csproj directly; the concrete GumService moved to SkiaGum.Standalone.csproj
	       (issue #4452 phase 2), which still brings SkiaGum.csproj transitively. -->
	  <ProjectReference Include="..\..\Runtimes\SkiaGum.Standalone\SkiaGum.Standalone.csproj" />
	  <ProjectReference Include="..\..\Runtimes\SkiaGum.ShadowDusk\SkiaGum.ShadowDusk.csproj" />
	  <!-- PixelComparer/PixelDiffResult (used by GoldenImages/*Tests.cs) live in the dependency-free
	       Gum.ImageDiff so gumcli diff-screenshots (#4174) can reuse the same comparer instead of
	       duplicating it. -->
	  <ProjectReference Include="..\..\Tools\Gum.ImageDiff\Gum.ImageDiff.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\FontContainerTestWriter.cs" Link="Shared\FontContainerTestWriter.cs" />
		<Compile Include="..\Shared\ShimRetention.cs" Link="Shared\ShimRetention.cs" />
		<Compile Include="..\Shared\TypedSetterSweep.cs" Link="Shared\TypedSetterSweep.cs" />
		<Compile Include="..\Shared\FileManagerState.cs" Link="Shared\FileManagerState.cs" />
		<Compile Include="..\Shared\FileManagerStateAssert.cs" Link="Shared\FileManagerStateAssert.cs" />
		<Compile Include="..\Shared\ObjectFinderState.cs" Link="Shared\ObjectFinderState.cs" />
		<Compile Include="..\Shared\ObjectFinderStateAssert.cs" Link="Shared\ObjectFinderStateAssert.cs" />
		<Compile Include="..\Shared\GraphicalUiElementState.cs" Link="Shared\GraphicalUiElementState.cs" />
		<Compile Include="..\Shared\GraphicalUiElementStateAssert.cs" Link="Shared\GraphicalUiElementStateAssert.cs" />
	</ItemGroup>

	<!-- Forms tests linked from MonoGameGum.Tests: same source runs against shared Skia code (#6511). -->
	<ItemGroup>
		<Compile Include="..\..\MonoGameGum.Tests\Forms\GamepadNavigationModeTests.cs" Link="Forms\Linked\GamepadNavigationModeTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\ControllerSpatialNavigationTests.cs" Link="Forms\Linked\ControllerSpatialNavigationTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\SpatialNavigationServiceTests.cs" Link="Forms\Linked\SpatialNavigationServiceTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\FocusTabNavigationTests.cs" Link="Forms\Linked\FocusTabNavigationTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\KeyComboTests.cs" Link="Forms\Linked\KeyComboTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\KeyboardDirectionalNavigationTests.cs" Link="Forms\Linked\KeyboardDirectionalNavigationTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\CheckBoxTests.cs" Link="Forms\Linked\CheckBoxTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\ScrollBarTests.cs" Link="Forms\Linked\ScrollBarTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\PanelTests.cs" Link="Forms\Linked\PanelTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\GridTests.cs" Link="Forms\Linked\GridTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\PasswordBoxTests.cs" Link="Forms\Linked\PasswordBoxTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\WindowTests.cs" Link="Forms\Linked\WindowTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\ButtonTests.cs" Link="Forms\Linked\ButtonTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\ListBoxTests.cs" Link="Forms\Linked\ListBoxTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\SliderTests.cs" Link="Forms\Linked\SliderTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\LabelTests.cs" Link="Forms\Linked\LabelTests.cs" />
		<Compile Include="..\..\MonoGameGum.Tests\Forms\RadioButtonTests.cs" Link="Forms\Linked\RadioButtonTests.cs" />
	</ItemGroup>

	<!-- Golden-image baselines for GoldenImages/*Tests.cs (pixel-diff regression tests). -->
	<ItemGroup>
		<None Include="GoldenImages\Baselines\**\*.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- Fixture TTF for CustomFontFile/#3703-3670 tests (copy of the Neon theme's Orbitron-Regular.ttf,
	     already repo-licensed for redistribution). -->
	<ItemGroup>
		<None Include="Assets\Fonts\TestFont.ttf">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
