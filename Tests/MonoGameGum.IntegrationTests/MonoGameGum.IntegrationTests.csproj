<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- The linked generated sample component uses the obsolete MonoGameGum.GueDeriving shims. -->
		<NoWarn>$(NoWarn);CS0618</NoWarn>

		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<!-- xunit v3 builds the tests as an exe. Program.cs owns Main so every test can run on the
		     process main thread, which macOS requires for a MonoGame window. -->
		<OutputType>Exe</OutputType>
		<XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
		<Configurations>Debug;Release;Release_No_Diagnostics</Configurations>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AutoFixture.AutoMoq" />
		<PackageReference Include="coverlet.collector" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" VersionOverride="17.14.1" />
		<PackageReference Include="Moq" />
		<PackageReference Include="Shouldly" />
		<PackageReference Include="xunit.v3" VersionOverride="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.1.5" />
		<PackageReference Include="MonoGame.Framework.DesktopGL" VersionOverride="3.8.4.1" />
		<PackageReference Include="ShadowDusk.Compiler" VersionOverride="0.22.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\..\MonoGameGum\MonoGameGum.csproj" />
		<ProjectReference Include="..\Gum.Automation\Gum.Automation.csproj" />
		<ProjectReference Include="..\..\Runtimes\GumShapes\MonoGameGumShapes.csproj" />
		<!-- Referenced so the in-memory font creator can be exercised end-to-end (KernSmith atlas
		     generation -> MonoGame Texture2D upload -> BitmapFont), mirroring RaylibGum.Tests. -->
		<ProjectReference Include="..\..\Integrations\KernSmith\KernSmith.MonoGameGum\KernSmith.MonoGameGum.csproj" />
		<!-- The packaged code-only themes, so a test can render each theme's visuals (MenuFocusRenderTests). -->
		<ProjectReference Include="..\..\Themes\Gum.Themes.Bubblegum.MonoGame\Gum.Themes.Bubblegum.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.DarkPro.MonoGame\Gum.Themes.DarkPro.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Editor.MonoGame\Gum.Themes.Editor.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.ForestGlade.MonoGame\Gum.Themes.ForestGlade.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Hazard.MonoGame\Gum.Themes.Hazard.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Meadow.MonoGame\Gum.Themes.Meadow.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Neon.MonoGame\Gum.Themes.Neon.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Retro95.MonoGame\Gum.Themes.Retro95.MonoGame.csproj" />
		<ProjectReference Include="..\..\Themes\Gum.Themes.Template.MonoGame\Gum.Themes.Template.MonoGame.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Linked rather than referencing MonoGameGum.TestsCommon, which pulls in xunit v2. -->
		<Compile Include="..\MonoGameGum.TestsCommon\AllocationMeasurer.cs" Link="AllocationMeasurer.cs" />
		<!-- Seed-driven test order for the weekly shuffled-order workflow (#6106). The xunit v3 orderers, not the v2 ones. -->
		<Compile Include="..\TestOrdering\TestShuffle.cs" Link="TestOrdering\TestShuffle.cs" />
		<Compile Include="..\TestOrdering\Xunit3\ShuffledTestCaseOrderer.cs" Link="TestOrdering\ShuffledTestCaseOrderer.cs" />
		<!-- The Preview window's shader resolver, linked because GumPreview is an executable. -->
		<Compile Include="..\..\Tool\GumPreview\PreviewShaderResolver.cs" Link="GumPreview\PreviewShaderResolver.cs" />
		<Compile Include="..\..\Tool\EditorTabPlugin.Core\Services\ShaderSourceCompiler.cs" Link="GumPreview\ShaderSourceCompiler.cs" />
		<Compile Include="..\..\Tool\GumPreview\PreviewDeviceSettings.cs" Link="GumPreview\PreviewDeviceSettings.cs" />
		<!-- A real code-generated runtime component (a ContainerRuntime), for the wrong-service ownership test. -->
		<Compile Include="..\..\Samples\GumFormsSample\GumFormsSampleCommon\Components\Controls\ButtonStandardRuntime.cs" Link="GeneratedSample\ButtonStandardRuntime.cs" />
		<Compile Include="..\..\Samples\GumFormsSample\GumFormsSampleCommon\Components\Controls\ButtonStandardRuntime.Generated.cs" Link="GeneratedSample\ButtonStandardRuntime.Generated.cs" />
	</ItemGroup>

	<ItemGroup>
		<!-- A real .ttf for the KernSmith font-registration tests, which read it back both through
		     a CustomGetStreamFromFile hook and off disk. -->
		<None Include="Content\Fonts\Orbitron-Black.ttf" CopyToOutputDirectory="PreserveNewest" />
		<!-- The shader the samples ship, so the tests run exactly that file. -->
		<None Include="..\..\Gum\Content\Shaders\Outline.slang" Link="Outline.slang" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\FileManagerState.cs" Link="Shared\FileManagerState.cs" />
    <Compile Include="..\Shared\FileManagerStateAssert.cs" Link="Shared\FileManagerStateAssert.cs" />
    <Compile Include="..\Shared\ObjectFinderState.cs" Link="Shared\ObjectFinderState.cs" />
    <Compile Include="..\Shared\ObjectFinderStateAssert.cs" Link="Shared\ObjectFinderStateAssert.cs" />
    <Compile Include="..\Shared\GraphicalUiElementState.cs" Link="Shared\GraphicalUiElementState.cs" />
    <Compile Include="..\Shared\GraphicalUiElementStateAssert.cs" Link="Shared\GraphicalUiElementStateAssert.cs" />
    <Compile Include="..\Shared\CrossRuntime\NineSliceCases.cs" Link="Shared\CrossRuntime\NineSliceCases.cs" />
		<Compile Include="..\Shared\CrossRuntime\NineSliceKnownDifferences.cs" Link="Shared\CrossRuntime\NineSliceKnownDifferences.cs" />
  </ItemGroup>

</Project>
