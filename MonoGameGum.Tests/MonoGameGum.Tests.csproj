<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
	<IsTestProject>true</IsTestProject>
	<Configurations>Debug;Release;Release_No_Diagnostics</Configurations>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

  </PropertyGroup>

  <!-- Mirrors MonoGameGum's own FULL_DIAGNOSTICS, which every configuration except Release_No_Diagnostics defines. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release_No_Diagnostics'">
    <DefineConstants>$(DefineConstants);FULL_DIAGNOSTICS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="AutoFixture.AutoMoq" />
	  <PackageReference Include="coverlet.collector" />
	  <PackageReference Include="Microsoft.NET.Test.Sdk" />
	  <PackageReference Include="Moq" />
	  <PackageReference Include="Shouldly" />
	  <PackageReference Include="xunit" />
	  <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" VersionOverride="3.8.4.1" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\MonoGameGum\MonoGameGum.csproj" />
		<ProjectReference Include="..\Runtimes\GumExpressions\GumExpressions.csproj" />
		<ProjectReference Include="..\Tests\MonoGameGum.TestsCommon\MonoGameGum.TestsCommon.csproj" />
		<!-- Build-only: ensures gumcli is built for the snapshot CLI-check tests, without importing its
		     assembly (Gum.ProjectServices + MonoGameGum both define the Forms control types, so importing
		     would be a CS0433 conflict). CI only: the reference pulls the whole CLI graph into every build of
		     this project, so a local build skips it and the tests build gumcli themselves with dotnet run. -->
		<ProjectReference Include="..\Tools\Gum.Cli\Gum.Cli.csproj" ReferenceOutputAssembly="false" Condition="'$(GITHUB_ACTIONS)' == 'true'" />
	</ItemGroup>

	<ItemGroup>
		<!-- Seed-driven test class and method order for the weekly shuffled-order workflow (#5820, #5840). -->
		<Compile Include="..\Tests\TestOrdering\TestShuffle.cs" Link="TestOrdering\TestShuffle.cs" />
		<Compile Include="..\Tests\TestOrdering\ShuffledTestCollectionOrderer.cs" Link="TestOrdering\ShuffledTestCollectionOrderer.cs" />
		<Compile Include="..\Tests\TestOrdering\ShuffledTestCaseOrderer.cs" Link="TestOrdering\ShuffledTestCaseOrderer.cs" />
		<!-- GumPreview is an executable, so its Forms interaction logic is linked rather than referenced. -->
		<Compile Include="..\Tool\GumPreview\PreviewInteraction.cs" Link="GumPreview\PreviewInteraction.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="TestContent\GumProject.zip">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>