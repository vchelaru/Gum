<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  The KNI Skia version of ../../MonoGameGumFontLoading: texts that load their font from a file,
	  drawn by SkiaGum through Runtimes/KniSkiaGum. Skia renders TrueType/OpenType files, not
	  bmfont .fnt atlases, so the fonts are .ttf files linked from the other samples.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<AssemblyName>KniSkiaGumFontLoading</AssemblyName>
		<TargetFramework>net8.0</TargetFramework>
		<RollForward>Major</RollForward>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<KniPlatform>DesktopGL</KniPlatform>
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="nkast.Xna.Framework" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Content" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Graphics" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Audio" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Media" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Input" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Game" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Devices" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Xna.Framework.Storage" Version="[4.3.9001]" />
		<PackageReference Include="nkast.Kni.Platform.SDL2.GL" Version="[4.3.9001]" />
		<!-- Draws Skia into a KNI Texture2D render target. Gum draws into that target's SKCanvas. -->
		<PackageReference Include="SkiaGameRendering.Kni.DesktopGL" Version="0.19.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\Runtimes\KniSkiaGum\KniSkiaGum.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\MonoGameGumInCode\MonoGameGumInCode\Content\Fonts\CustomFont.ttf" Link="Content\Fonts\CustomFont.ttf" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\SilkNetGum\SilkNetGumSample\Super Morning.ttf" Link="Content\Fonts\Super Morning.ttf" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\SilkNetGum\SilkNetGumSample\Winter Selfie.ttf" Link="Content\Fonts\Winter Selfie.ttf" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
