<Project Sdk="Microsoft.NET.Sdk">

	<!--
		A minimal "write your own backend" reference: Gum rendered by SDL3's 2D renderer (SDL_Renderer).
		It references only GumCommon and an SDL3 binding. Everything a backend needs lives in Backend/.
	-->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Content\**\*.*" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\GumCommon\GumCommon.csproj" />
	</ItemGroup>

</Project>
