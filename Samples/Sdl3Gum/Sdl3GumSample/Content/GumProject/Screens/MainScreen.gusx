<?xml version="1.0" encoding="utf-8"?>
<ScreenSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>MainScreen</Name>
  <State>
    <Name>Default</Name>
    <Variable Type="string" Name="Panel.SourceFile" SetsValue="true"><Value xsi:type="xsd:string">Frame.png</Value></Variable>
    <Variable Type="float" Name="Panel.X" SetsValue="true"><Value xsi:type="xsd:float">20</Value></Variable>
    <Variable Type="float" Name="Panel.Y" SetsValue="true"><Value xsi:type="xsd:float">20</Value></Variable>
    <Variable Type="float" Name="Panel.Width" SetsValue="true"><Value xsi:type="xsd:float">340</Value></Variable>
    <Variable Type="float" Name="Panel.Height" SetsValue="true"><Value xsi:type="xsd:float">220</Value></Variable>
    <Variable Type="string" Name="Row.Parent" SetsValue="true"><Value xsi:type="xsd:string">Panel</Value></Variable>
    <Variable Type="float" Name="Row.X" SetsValue="true"><Value xsi:type="xsd:float">16</Value></Variable>
    <Variable Type="float" Name="Row.Y" SetsValue="true"><Value xsi:type="xsd:float">16</Value></Variable>
    <Variable Type="ChildrenLayout" Name="Row.ChildrenLayout" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="Row.StackSpacing" SetsValue="true"><Value xsi:type="xsd:float">8</Value></Variable>
    <Variable Type="DimensionUnitType" Name="Row.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">4</Value></Variable>
    <Variable Type="DimensionUnitType" Name="Row.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">4</Value></Variable>
    <Variable Type="float" Name="Row.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="float" Name="Row.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="string" Name="BearSmall.Parent" SetsValue="true"><Value xsi:type="xsd:string">Row</Value></Variable>
    <Variable Type="string" Name="BearSmall.SourceFile" SetsValue="true"><Value xsi:type="xsd:string">BearTexture.png</Value></Variable>
    <Variable Type="string" Name="BearLarge.Parent" SetsValue="true"><Value xsi:type="xsd:string">Row</Value></Variable>
    <Variable Type="string" Name="BearLarge.SourceFile" SetsValue="true"><Value xsi:type="xsd:string">BearTexture.png</Value></Variable>
    <Variable Type="float" Name="BearLarge.Width" SetsValue="true"><Value xsi:type="xsd:float">200</Value></Variable>
    <Variable Type="float" Name="BearLarge.Height" SetsValue="true"><Value xsi:type="xsd:float">200</Value></Variable>
    <Variable Type="string" Name="BearCropped.Parent" SetsValue="true"><Value xsi:type="xsd:string">Row</Value></Variable>
    <Variable Type="string" Name="BearCropped.SourceFile" SetsValue="true"><Value xsi:type="xsd:string">BearTexture.png</Value></Variable>
    <Variable Type="TextureAddress" Name="BearCropped.TextureAddress" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="int" Name="BearCropped.TextureLeft" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="BearCropped.TextureTop" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="BearCropped.TextureWidth" SetsValue="true"><Value xsi:type="xsd:int">20</Value></Variable>
    <Variable Type="int" Name="BearCropped.TextureHeight" SetsValue="true"><Value xsi:type="xsd:int">20</Value></Variable>
    <Variable Type="float" Name="BearCropped.Width" SetsValue="true"><Value xsi:type="xsd:float">400</Value></Variable>
    <Variable Type="float" Name="BearCropped.Height" SetsValue="true"><Value xsi:type="xsd:float">400</Value></Variable>
    <Variable Type="string" Name="WideFrame.Parent" SetsValue="true"><Value xsi:type="xsd:string">Panel</Value></Variable>
    <Variable Type="string" Name="WideFrame.SourceFile" SetsValue="true"><Value xsi:type="xsd:string">Frame.png</Value></Variable>
    <Variable Type="float" Name="WideFrame.X" SetsValue="true"><Value xsi:type="xsd:float">16</Value></Variable>
    <Variable Type="float" Name="WideFrame.Y" SetsValue="true"><Value xsi:type="xsd:float">-16</Value></Variable>
    <Variable Type="GeneralUnitType" Name="WideFrame.YUnits" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="VerticalAlignment" Name="WideFrame.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="WideFrame.Width" SetsValue="true"><Value xsi:type="xsd:float">-32</Value></Variable>
    <Variable Type="DimensionUnitType" Name="WideFrame.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="WideFrame.Height" SetsValue="true"><Value xsi:type="xsd:float">40</Value></Variable>
  </State>
  <Instance><Name>Panel</Name><BaseType>NineSlice</BaseType><DefinedByBase>false</DefinedByBase></Instance>
