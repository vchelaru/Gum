<Project Sdk="Microsoft.NET.Sdk">

	<!--
		DataUi.Core: the framework-neutral member model behind the property grid (phase 70 of
		Direction/avalonia-migration/). InstanceMember, MemberCategory, the grid's category and
		filter logic (DataUiGridModel), displayer selection (DisplayerRegistry), and the editor
		logic classes (TextBoxDisplayLogic, FilePickingLogic, InlineChannelsDisplayLogic). The WPF
		grid (WpfDataUi) and the Avalonia grid (AvaloniaDataUi) are two views over this model.

		The namespaces stay WpfDataUi.* so existing consumers compile unchanged. Single-targets
		net8.0 (WpfDataUi does the same) rather than also multi-targeting net10.0: nothing here
		needs a net10-only API (no UI framework, and the banned-symbol list keeps Windows-only APIs
		out too), and net10.0's *presence* in this list - even unused - breaks any consumer building
		with an SDK that predates net10, since evaluating that TFM at all requires SDK support for
		it. AvaloniaDataUi (net10.0) and Gum.csproj (net10.0-windows) still reference this fine: a
		newer-TFM project consuming an older-TFM library is ordinary downward compatibility, no
		different from any other still-net8.0 NuGet package. FlatRedBall's Glue (net8.0-windows)
		needed exactly this - not a second net10.0 leg it can't build against anyway.
	-->
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>WpfDataUi</RootNamespace>
		<AssemblyName>DataUi.Core</AssemblyName>
		<!-- LateBinder is shared source that picks its namespace from this symbol. -->
		<DefineConstants>$(DefineConstants);WpfDataUi</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="WpfDataUi" />
		<InternalsVisibleTo Include="AvaloniaDataUi" />
		<InternalsVisibleTo Include="Gum.Presentation.Tests" />
		<InternalsVisibleTo Include="GumToolUnitTests" />
		<InternalsVisibleTo Include="Gum.Avalonia.Tests" />
	</ItemGroup>

</Project>
