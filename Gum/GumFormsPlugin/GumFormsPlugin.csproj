<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<LangVersion>12.0</LangVersion>
		<AnalysisLevel>none</AnalysisLevel>
		<Nullable>enable</Nullable>

		<UseWPF>true</UseWPF>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <Optimize>false</Optimize>
	  <OutputPath>bin\Debug\</OutputPath>
	  <DefineConstants>DEBUG;TRACE</DefineConstants>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>pdbonly</DebugType>
	  <Optimize>true</Optimize>
	  <OutputPath>bin\Release\</OutputPath>
	  <DefineConstants>TRACE</DefineConstants>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="System.ComponentModel.Composition" />
	</ItemGroup>
	<ItemGroup>
		<Compile Include="MainGumFormsPlugin.cs" />
		<Compile Include="Properties\AssemblyInfo.cs" />
		<Compile Include="Services\FormsFileService.cs" />
		<Compile Include="Views\AddFormsWindow.xaml.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\FlatRedBall.SpecializedXnaControls\FlatRedBall.SpecializedXnaControls.csproj">
			<Project>{8c80ba7b-1cba-4579-9382-d9dc6c365070}</Project>
			<Name>FlatRedBall.SpecializedXnaControls</Name>
		</ProjectReference>
		<ProjectReference Include="..\Gum.csproj">
			<Project>{121ac5a5-8f6a-42b2-8863-debc45b052bc}</Project>
			<Name>Gum</Name>
		</ProjectReference>
		<ProjectReference Include="..\..\InputLibrary\InputLibrary.csproj">
			<Project>{938d9a00-8529-4ce8-9077-e0a3994a73ea}</Project>
			<Name>InputLibrary</Name>
		</ProjectReference>
		<ProjectReference Include="..\..\WpfDataUi\WpfDataUi.csproj">
			<Project>{47241002-7eb5-433b-b931-a530bb6b84ee}</Project>
			<Name>WpfDataUi</Name>
		</ProjectReference>
		<ProjectReference Include="..\..\XnaAndWinforms\XnaAndWinforms.csproj">
			<Project>{c39a973c-66d6-4a6c-82b5-ae0042f210f8}</Project>
			<Name>XnaAndWinforms</Name>
		</ProjectReference>
		<!-- Not linked into this assembly - only referenced so MSBuild builds Gum.FormsStaging before
		     this project's postbuild step, which shells out to it to stage shared Forms behaviors
		     (#4070). Deliberately Gum.FormsStaging, not Gum.Cli: Gum.Cli references the MonoGame/
		     Raylib/SkiaGum backends (for its screenshot/svg commands), which pulls MonoGameGum's
		     mobile-workload-gated targets into every build of this project (#4236). -->
		<ProjectReference Include="..\..\Tools\Gum.FormsStaging\Gum.FormsStaging.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="echo Building Gum.FormsStaging (postbuild depends on it, but solution-level build order across projects isn't guaranteed in all environments - #4070)&#xD;&#xA;dotnet build &quot;$(SolutionDir)Tools\Gum.FormsStaging\Gum.FormsStaging.csproj&quot; -c $(ConfigurationName) --nologo&#xD;&#xA;&#xD;&#xA;echo Copying plugin to &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Plugins\$(TargetName)\&quot;&#xD;&#xA;IF NOT EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Plugins\$(TargetName)&quot; md &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Plugins\$(TargetName)\&quot;&#xD;&#xA;&#xD;&#xA;copy &quot;$(TargetPath)&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Plugins\$(TargetName)&quot;&#xD;&#xA;&#xD;&#xA;copy &quot;$(TargetDir)$(TargetName).pdb&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Plugins\$(TargetName)&quot;&#xD;&#xA;&#xD;&#xA;echo Copying Standard theme to &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard\&quot;&#xD;&#xA;IF EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard&quot; rd /s /q &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard&quot;&#xD;&#xA;IF NOT EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard&quot; md &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard\&quot;&#xD;&#xA;xcopy /E /Y /I &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsTemplate\*&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard\&quot;&#xD;&#xA;&#xD;&#xA;echo Staging shared behaviors into Standard theme (SourcePath links can't be plain-xcopy'd - #4070)&#xD;&#xA;dotnet &quot;$(SolutionDir)Tools\Gum.FormsStaging\bin\$(ConfigurationName)\net8.0\Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsTemplate\GumProject.gumx&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Standard\Behaviors&quot;&#xD;&#xA;&#xD;&#xA;echo Copying Bubblegum theme to &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum\&quot;&#xD;&#xA;IF EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum&quot; rd /s /q &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum&quot;&#xD;&#xA;IF NOT EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum&quot; md &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum\&quot;&#xD;&#xA;xcopy /E /Y /I &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsThemes\Bubblegum\*&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum\&quot;&#xD;&#xA;&#xD;&#xA;echo Staging shared behaviors into Bubblegum theme (SourcePath links can't be plain-xcopy'd - #4070)&#xD;&#xA;dotnet &quot;$(SolutionDir)Tools\Gum.FormsStaging\bin\$(ConfigurationName)\net8.0\Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsThemes\Bubblegum\GumProject.gumx&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Bubblegum\Behaviors&quot;&#xD;&#xA;&#xD;&#xA;echo Copying Hazard theme to &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard\&quot;&#xD;&#xA;IF EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard&quot; rd /s /q &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard&quot;&#xD;&#xA;IF NOT EXIST &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard&quot; md &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard\&quot;&#xD;&#xA;xcopy /E /Y /I &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsThemes\Hazard\*&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard\&quot;&#xD;&#xA;&#xD;&#xA;echo Staging shared behaviors into Hazard theme (SourcePath links can't be plain-xcopy'd - #4070)&#xD;&#xA;dotnet &quot;$(SolutionDir)Tools\Gum.FormsStaging\bin\$(ConfigurationName)\net8.0\Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools\Gum.ProjectServices\Templates\FormsThemes\Hazard\GumProject.gumx&quot; &quot;$(SolutionDir)Gum\bin\$(ConfigurationName)\Content\FormsThemes\Hazard\Behaviors&quot;" />
	</Target>
</Project>
