<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<LangVersion>12.0</LangVersion>
		<AnalysisLevel>none</AnalysisLevel>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugSymbols>true</DebugSymbols>
	  <DebugType>full</DebugType>
	  <Optimize>false</Optimize>
	  <OutputPath>bin\Debug\</OutputPath>
	  <DefineConstants>DEBUG;TRACE</DefineConstants>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>pdbonly</DebugType>
	  <Optimize>true</Optimize>
	  <OutputPath>bin\Release\</OutputPath>
	  <DefineConstants>TRACE</DefineConstants>
	  <ErrorReport>prompt</ErrorReport>
	  <WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.ComponentModel.Composition" Version="9.0.3" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="MainGumFormsPlugin.cs" />
		<Compile Include="Properties\AssemblyInfo.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\Tools\Gum.Presentation\Gum.Presentation.csproj" />
		<!-- Not linked into this assembly - only referenced so MSBuild builds Gum.FormsStaging before
		     this project's postbuild step, which shells out to it to stage shared Forms behaviors
		     (#4070). Deliberately Gum.FormsStaging, not Gum.Cli: Gum.Cli references the MonoGame/
		     Raylib/SkiaGum backends (for its screenshot/svg commands), which pulls MonoGameGum's
		     mobile-workload-gated targets into every build of this project (#4236). -->
		<ProjectReference Include="..\..\Tools\Gum.FormsStaging\Gum.FormsStaging.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>
	<ItemGroup>
		<!-- Cross-platform purity guard: no Windows-only APIs in a plugin the Avalonia head hosts. -->
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Built outside a solution (a test project on its own, CI on macOS/Linux) the repo root is two levels up. -->
		<PropertyGroup>
			<SolutionDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
			<AvaloniaHeadDir>$(SolutionDir)Tool/Gum.Avalonia/bin/$(ConfigurationName)/net10.0/</AvaloniaHeadDir>
		</PropertyGroup>
		<!-- Gum.FormsStaging isn't guaranteed to build before this project in a solution build,
		     so build it explicitly before shelling out to it below (#4070). -->
		<Exec Command="dotnet build &quot;$(SolutionDir)Tools/Gum.FormsStaging/Gum.FormsStaging.csproj&quot; -c $(ConfigurationName) --nologo" />

		<ItemGroup>
			<PluginOutputFiles Include="$(TargetPath)" />
			<PluginOutputFiles Include="$(TargetDir)$(TargetName).pdb" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Plugins/$(TargetName)" />
		<Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(AvaloniaHeadDir)Plugins/$(TargetName)" />

		<!-- Stage each Forms theme's template content, then run Gum.FormsStaging to layer in the
		     shared behaviors (SourcePath links in the templates can't be plain-copied - #4070). -->
		<ItemGroup>
			<StandardThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsTemplate/**/*.*" />
			<BubblegumThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Bubblegum/**/*.*" />
			<HazardThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Hazard/**/*.*" />
			<DarkProThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/DarkPro/**/*.*" />
			<Retro95ThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Retro95/**/*.*" />
			<ForestGladeThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/ForestGlade/**/*.*" />
			<NeonThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Neon/**/*.*" />
			<MeadowThemeFiles Include="$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Meadow/**/*.*" />
		</ItemGroup>

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Standard" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Standard')" />
		<Copy SourceFiles="@(StandardThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Standard/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsTemplate/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Standard/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Bubblegum" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Bubblegum')" />
		<Copy SourceFiles="@(BubblegumThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Bubblegum/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Bubblegum/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Bubblegum/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Hazard" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Hazard')" />
		<Copy SourceFiles="@(HazardThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Hazard/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Hazard/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Hazard/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/DarkPro" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/DarkPro')" />
		<Copy SourceFiles="@(DarkProThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/DarkPro/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/DarkPro/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/DarkPro/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Retro95" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Retro95')" />
		<Copy SourceFiles="@(Retro95ThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Retro95/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Retro95/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Retro95/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/ForestGlade" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/ForestGlade')" />
		<Copy SourceFiles="@(ForestGladeThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/ForestGlade/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/ForestGlade/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/ForestGlade/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Neon" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Neon')" />
		<Copy SourceFiles="@(NeonThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Neon/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Neon/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Neon/Behaviors&quot;" />

		<RemoveDir Directories="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Meadow" Condition="Exists('$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Meadow')" />
		<Copy SourceFiles="@(MeadowThemeFiles)" DestinationFolder="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Meadow/%(RecursiveDir)" />
		<Exec Command="dotnet &quot;$(SolutionDir)Tools/Gum.FormsStaging/bin/$(ConfigurationName)/net10.0/Gum.FormsStaging.dll&quot; &quot;$(SolutionDir)Tools/Gum.ProjectServices/Templates/FormsThemes/Meadow/GumProject.gumx&quot; &quot;$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/Meadow/Behaviors&quot;" />

		<!-- The Avalonia head reads the same staged themes from its own Content folder. -->
		<ItemGroup>
			<StagedFormsThemeFiles Include="$(SolutionDir)Gum/bin/$(ConfigurationName)/Content/FormsThemes/**/*.*" />
		</ItemGroup>
		<RemoveDir Directories="$(AvaloniaHeadDir)Content/FormsThemes" Condition="Exists('$(AvaloniaHeadDir)Content/FormsThemes')" />
		<Copy SourceFiles="@(StagedFormsThemeFiles)" DestinationFolder="$(AvaloniaHeadDir)Content/FormsThemes/%(RecursiveDir)" />
	</Target>
</Project>
