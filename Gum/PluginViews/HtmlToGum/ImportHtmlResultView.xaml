<UserControl
    x:Class="Gum.PluginViews.HtmlToGum.ImportHtmlResultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogs="clr-namespace:Gum.Services.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    dialogs:Dialog.DialogTitle="{Binding Title}"
    dialogs:Dialog.ScrollContent="False"
    Width="420"
    mc:Ignorable="d">

    <!-- After an HTML import: the summary, and the converter log behind a toggle. Bound to
         HtmlToGumPlugin.ImportHtmlResultViewModel. -->
    <StackPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <Button
            Margin="0,12,0,0"
            HorizontalAlignment="Left"
            Padding="8,2"
            Command="{Binding ToggleDetailsCommand}"
            Content="{Binding DetailsButtonText}"
            Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibilityConverter}}" />
        <TextBox
            Height="220"
            Margin="0,8,0,0"
            FontFamily="Consolas"
            IsReadOnly="True"
            Text="{Binding Details, Mode=OneWay}"
            TextWrapping="NoWrap"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Auto"
            Visibility="{Binding IsDetailsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
