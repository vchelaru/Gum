<UserControl
  x:Class="Gum.Services.Dialogs.PluginsDialogView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:Gum.Services.Dialogs"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="500"
  MinWidth="500"
  MinHeight="400"
  HorizontalAlignment="Stretch"
  VerticalAlignment="Stretch"
  local:Dialog.DialogTitle="{Binding Title}"
  local:Dialog.ScrollContent="False"
  mc:Ignorable="d">
  <!-- No MaxHeight anywhere: WPF caps a Stretch element at its MaxHeight and then centers it in the
       leftover space, so the content would float mid-window and stop growing when the window did.
       Both tabs scroll internally instead, which bounds tall content without bounding the control. -->
  <TabControl
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <TabItem Header="Plugins">
      <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Plugins}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox
                Margin="4,4,4,0"
                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                Content="{Binding DisplayText}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </TabItem>

    <!-- Says which folder was searched and what was in it, so a plugin missing from the Plugins tab
         can be told apart from one that was never installed. Read-only but selectable, since the
         useful thing to do with it is paste it into a bug report. VerticalContentAlignment is set
         explicitly because the app's TextBox style centers content, which for a multi-line box
         floats the text in the middle of the box. -->
    <TabItem Header="Folder scan">
      <TextBox
        Padding="4"
        AcceptsReturn="True"
        BorderThickness="0"
        FontFamily="Consolas"
        HorizontalScrollBarVisibility="Auto"
        IsReadOnly="True"
        Text="{Binding Diagnostics, Mode=OneWay}"
        TextWrapping="Wrap"
        VerticalAlignment="Stretch"
        VerticalContentAlignment="Top"
        VerticalScrollBarVisibility="Auto" />
    </TabItem>
  </TabControl>
</UserControl>
