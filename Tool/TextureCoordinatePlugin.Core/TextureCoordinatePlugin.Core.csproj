<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>TextureCoordinateSelectionPlugin</RootNamespace>
		<!--
			The framework-neutral texture-coordinates tab: the display controller, the overlay
			managers, the exposed-coordinate logic, and the abstract plugin
			(TextureCoordinatePluginBase) that each head completes with its own view. Compiles
			against the KNI reference assemblies only.
		-->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GumToolUnitTests" />
		<InternalsVisibleTo Include="Gum.Presentation.Tests" />
		<InternalsVisibleTo Include="Gum.Avalonia.Tests" />
		<InternalsVisibleTo Include="TextureCoordinateSelectionPlugin" />
		<InternalsVisibleTo Include="Gum.Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Tools\Gum.Presentation\Gum.Presentation.csproj" />
		<ProjectReference Include="..\..\MonoGameGum\KniGum\KniGum.csproj" />
		<ProjectReference Include="..\..\FlatRedBall.SpecializedXnaControls\FlatRedBall.SpecializedXnaControls.csproj" />
		<ProjectReference Include="..\..\XnaAndWinforms\XnaAndWinforms.csproj" />
		<ProjectReference Include="..\..\InputLibrary\InputLibrary.csproj" />
	</ItemGroup>
</Project>
