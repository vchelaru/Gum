<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Gum.Avalonia: the cross-platform (Windows / macOS / Linux) head of the Gum tool. See
		Direction/avalonia-migration/README.md. It composes the same headless service graph as the
		WPF head (Gum.Presentation's AddGumCore) and supplies Avalonia implementations of every
		contract in GumCoreServiceCollectionExtensions.HeadProvidedContracts.

		This project targets plain net10.0 and must never reference WPF, WinForms, or any
		net10.0-windows project. The banned-symbol list turns the runtime-only Windows APIs into
		build errors as well.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<AssemblyName>Gum.Avalonia</AssemblyName>
		<RootNamespace>Gum.Avalonia</RootNamespace>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
		<NoWarn>1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.17" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
		<!--
			The editor canvases draw with KNI. The framework packages are the reference assemblies
			the neutral canvas projects compile against; the SDL2/GL platform is the one concrete
			backend this head loads, on every OS (phase 10 of the Avalonia plan chose it).
		-->
		<PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Audio" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Media" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Game" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Devices" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Storage" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.XR" Version="4.2.9001" />
		<PackageReference Include="nkast.Kni.Platform.SDL2.GL" Version="4.2.9001.1" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\..\Runtimes\GumExpressions\GumExpressions.csproj" />
		<ProjectReference Include="..\..\Tools\Gum.ProjectServices\Gum.ProjectServices.csproj" />
		<ProjectReference Include="..\..\Tools\Gum.Presentation\Gum.Presentation.csproj" />
		<ProjectReference Include="..\..\XnaAndWinforms\XnaAndWinforms.csproj" />
		<ProjectReference Include="..\..\InputLibrary\InputLibrary.csproj" />
		<!-- The editor tab's neutral core (canvas, editors, rulers); this head adds the Avalonia canvas control and layout. -->
		<ProjectReference Include="..\EditorTabPlugin.Core\EditorTabPlugin.Core.csproj" />
		<ProjectReference Include="..\TextureCoordinatePlugin.Core\TextureCoordinatePlugin.Core.csproj" />
		<ProjectReference Include="..\..\AvaloniaDataUi\AvaloniaDataUi.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The editor's default bitmap font and the missing-texture placeholder, shared with the WPF head. -->
		<None Include="..\..\Gum\Content\TestFont.fnt" Link="Content\TestFont.fnt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\Gum\Content\TestFont_0.png" Link="Content\TestFont_0.png" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\Gum\Content\InvalidTexture.png" Link="Content\InvalidTexture.png" CopyToOutputDirectory="PreserveNewest" />
		<!-- The default font character set copied into new projects (FileCommands.CreateDefaultFontCharacterFile). -->
		<None Include="..\..\Gum\Content\.gumfcs" Link="Content\.gumfcs" CopyToOutputDirectory="PreserveNewest" />
		<!-- The tool font the rulers and dimension displays draw with (ToolFontService). -->
		<None Include="..\..\Gum\Content\Fonts\Font18Arial_o1.fnt" Link="Content\Fonts\Font18Arial_o1.fnt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\Gum\Content\Fonts\Font18Arial_o1_0.png" Link="Content\Fonts\Font18Arial_o1_0.png" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Gum.Avalonia.Tests" />
	</ItemGroup>

</Project>
