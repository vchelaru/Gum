<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>Gum</RootNamespace>
		<!--
			The framework-neutral element tree: the node model (GumTreeNode), the selection model and
			decision logic, the manager that builds, refreshes, searches and selects nodes
			(ElementTreeViewManager), and the plugin that drives it. Each head supplies only the view,
			through IElementTreeView (Gum/Plugins/InternalPlugins/TreeView for WPF,
			Tool/Gum.Avalonia/Plugins/TreeView for Avalonia).
		-->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Gum" />
		<InternalsVisibleTo Include="Gum.Avalonia" />
		<InternalsVisibleTo Include="GumToolUnitTests" />
		<InternalsVisibleTo Include="Gum.Presentation.Tests" />
		<InternalsVisibleTo Include="Gum.Avalonia.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Tools\Gum.Presentation\Gum.Presentation.csproj" />
	</ItemGroup>
</Project>
