<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Library</OutputType>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<DefineConstants>GUM; MONOGAME</DefineConstants>
		<!--
			The framework-neutral editor tab: the wireframe canvas logic (WireframeCanvasCore), the
			editors, visuals, rulers, services, view model, and the abstract plugin
			(EditorTabPluginBase) that each head completes with its own control, tab layout, context
			menu, and drop reader. Compiles against the KNI reference assemblies only; the head's
			executable supplies the platform (DX11 under the WPF tool, SDL2/GL under Avalonia).
		-->
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GumToolUnitTests" />
		<InternalsVisibleTo Include="Gum.Avalonia.Tests" />
		<InternalsVisibleTo Include="EditorTabPlugin_XNA" />
		<InternalsVisibleTo Include="Gum.Avalonia" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="nkast.Xna.Framework" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Graphics" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Input" Version="4.2.9001" />
		<PackageReference Include="nkast.Xna.Framework.Content" Version="4.2.9001" />
		<!--
			Compiles a render-target Container's SourceShaderFile (.fx) at runtime for the preview; each
			head picks the bytecode target its device accepts (RenderTargetShaderResolver).
		-->
		<PackageReference Include="ShadowDusk.Compiler" Version="0.17.0" />
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Tools\Gum.Presentation\Gum.Presentation.csproj" />
		<ProjectReference Include="..\..\MonoGameGum\KniGum\KniGum.csproj" />
		<!--
			KniGumShapes brings the Apos.Shapes-backed Circle / RoundedRectangle / Arc / Line renderables
			into the tool; its [ModuleInitializer] registers them with the RenderableRegistry. See issue #2925.
		-->
		<ProjectReference Include="..\..\Runtimes\GumShapes\KniGumShapes.csproj" />
		<ProjectReference Include="..\..\XnaAndWinforms\XnaAndWinforms.csproj" />
		<ProjectReference Include="..\..\InputLibrary\InputLibrary.csproj" />
	</ItemGroup>
</Project>
