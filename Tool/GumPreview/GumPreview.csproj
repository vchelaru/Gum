<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			The runtime host the Gum tool's Preview button (issue #4697) launches: loads a project's
			.gumx directly (no codegen, no recompile) and shows the screen/component selected in the
			tool. Built alongside the tool and shipped next to the head executable in a Preview/ folder
			(see PreviewExecutableLocator in Tool/EditorTabPlugin.Core), not resolved from PATH.
		-->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<Nullable>enable</Nullable>
		<AssemblyName>GumPreview</AssemblyName>
		<!--
			Per-Monitor-V2 DPI awareness (issue #4841), mirroring Tool/Gum.Avalonia/app.manifest so
			Preview matches the canvas it previews - both render at physical-pixel resolution instead
			of a DPI-unaware bitmap Windows then stretches (blurry, and no longer 1:1 with the canvas).
			Windows-only setting; ignored on other platforms MonoGame DesktopGL targets.
		-->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>
	<!--
		ReadyToRun precompiles native code ahead of time to reduce first-call JIT cost, same pattern
		as Gum.csproj (#4282) - startup latency is the whole point of Preview. This is the build used
		for .gumx (XML) projects, whose load path is a plain XmlSerializer that is not
		Native-AOT-safe (see IConvertProjectToJsonService). Only meaningful for a RID-specific
		publish; no effect on `dotnet build`. Skipped when publishing the Native AOT variant below
		(PublishReadyToRun and PublishAot are alternatives, not composable).
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(PublishAot)' != 'true'">
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>
	<!--
		Native AOT variant (issue #4706), published as a second `dotnet publish -p:PublishAot=true`
		invocation of this same csproj alongside the default ReadyToRun publish above - not a second
		project. Starts dramatically faster than ReadyToRun (no CoreCLR bootstrap, no JIT at all), but
		is only safe for .gumj (JSON) projects; PreviewExecutableLocator/PreviewLauncher pick this
		build over the ReadyToRun one based on GumProjectSave.IsJsonFormat, and fall back to
		ReadyToRun for a platform/package that has not published this variant. Proven trim-safe for
		Forms controls (RegisterFromFileFormRuntimeDefaults + BehaviorFormsPropertyApplier's
		reflection) by Tests/NativeAotSmoke.Harness.
	-->

	<PropertyGroup>
		<_PreviewVariantRid Condition="'$(_PreviewVariantRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</_PreviewVariantRid>
		<_HeadBinDir>$(MSBuildThisFileDirectory)..\Gum.Avalonia\bin\$(Configuration)\net10.0\</_HeadBinDir>
		<!--
			PublishAot's native link step shells out to vswhere.exe to find the MSVC linker, and it is
			NOT on PATH by default even with Visual Studio installed - the same reason
			build-and-test.yaml's "Native-AOT-Smoke" job has its own "Add vswhere to PATH" step. That
			workaround only covers CI; a local Build Solution needs the same fix baked into the nested
			publish's own environment (below) so it works with no one-time machine setup.
			$(MSBuildProgramFiles32) is the standard MSBuild property for "Program Files (x86)" -
			avoids the escaping issues in referencing an environment variable literally named
			"ProgramFiles(x86)" through $(...) syntax.
		-->
		<_VsWhereDir>$(MSBuildProgramFiles32)\Microsoft Visual Studio\Installer</_VsWhereDir>
		<_VsWhereExe>$(_VsWhereDir)\vswhere.exe</_VsWhereExe>
		<!--
			Prepended to the AOT publish's own Command below (not the ReadyToRun one - crossgen2 is
			managed and cross-platform, and never needs vswhere or the MSVC linker). Exec's own
			EnvironmentVariables parameter can't express this: it's a semicolon-delimited list of
			NAME=VALUE entries with no escape for a semicolon *inside* one entry's value, which a PATH
			value inherently needs. Folding a `set "PATH=...` into the Command string itself (still one
			cmd.exe invocation, chained with &&) has no such restriction. Empty on non-Windows, where
			`set` isn't valid shell syntax and the AOT toolchain doesn't need vswhere anyway.
		-->
		<_AotExecCommandPrefix Condition="'$(OS)' == 'Windows_NT'">set &quot;PATH=%PATH%;$(_VsWhereDir)&quot; &amp;&amp; </_AotExecCommandPrefix>
	</PropertyGroup>
	<!--
		Local-dev convenience: an ordinary Debug Build Solution also publishes both variants straight
		into the Avalonia head's own Debug bin output, in the exact Preview/ + Preview-Aot/ layout
		PreviewExecutableLocator's published-layout candidate already checks first - so a locally-run
		head's Preview picks the right build for a .gumx vs .gumj project with no special workflow
		(build-and-release.yml is still what produces the real 4-RID release artifacts; this only
		publishes for the current machine's RID). The two nested publishes are always -c Release
		regardless (PublishReadyToRun above is gated to Release - a Debug-config "Preview" build would
		silently never be ReadyToRun and defeat the point of testing the real variant), so this can
		only ever trigger for a Debug build, never Release.

		Gated to Configuration == Debug specifically so this never touches CI or a real release build:
		build-and-test.yaml's `dotnet build Gum.slnx` and every publish in build-and-release.yml both
		run Release, and that Configuration mismatch is also what stops the nested Release publishes
		above from recursively re-triggering this same target (also redundantly guarded by
		SkipPreviewVariantPublish, which they pass too). Also skipped for Visual Studio's design-time
		builds (IntelliSense) so typing doesn't trigger it.

		IgnoreStandardErrorWarningFormat on both: without it, MSBuild's console logger promotes every
		canonical `file(line): warning CODE: ...` line the nested publish prints - including the
		.gumx/XmlSerializer AOT-analysis warnings that are the whole reason the AOT build is
		.gumj-only, already an accepted, documented tradeoff, not a regression - into the *outer*
		build's own warning count, and plain verbosity flags do not help (MSBuild always shows
		warnings/errors regardless of verbosity level). Confirmed clean across repeated from-scratch
		rebuilds: the outer build's warning count matches a plain build with this target skipped
		exactly. A genuine failure of the nested publish still fails this target -
		IgnoreStandardErrorWarningFormat only changes how matching output lines are logged, not the
		Exec task's own exit-code check. (Redirecting the nested command's output away entirely was
		tried first and rejected: it intermittently made the Native AOT publish itself fail for
		reasons not fully understood, most likely the native link step's own subprocess needing a
		live console handle.)

		The Native AOT variant is skipped, with a high-importance message, when the MSVC linker is
		not installed (on Windows: no Visual Studio product with the "Desktop development with C++"
		tools, probed through vswhere) so building the tool never requires an extra VS workload -
		the same rule the runtimes follow for the mobile workloads. PreviewExecutableLocator falls
		back to the ReadyToRun Preview for .gumj projects when Preview-Aot is absent. The release
		workflow publishes the AOT variant with its own `dotnet publish -p:PublishAot=true` and is
		unaffected by this probe.
	-->
	<Target Name="PublishPreviewVariants" AfterTargets="Build"
	        Condition="'$(Configuration)' == 'Debug' AND '$(SkipPreviewVariantPublish)' != 'true' AND '$(DesignTimeBuild)' != 'true'">
		<Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r $(_PreviewVariantRid) --self-contained true -p:SkipPreviewVariantPublish=true -o &quot;$(_HeadBinDir)Preview&quot;"
		      IgnoreStandardErrorWarningFormat="true" />

		<Exec Condition="'$(OS)' == 'Windows_NT' AND Exists('$(_VsWhereExe)')"
		      Command="&quot;$(_VsWhereExe)&quot; -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath"
		      ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
			<Output TaskParameter="ConsoleOutput" PropertyName="_AotLinkerVsInstallation" />
		</Exec>
		<PropertyGroup>
			<_CanPublishAot>true</_CanPublishAot>
			<_CanPublishAot Condition="'$(OS)' == 'Windows_NT' AND '$(_AotLinkerVsInstallation)' == ''">false</_CanPublishAot>
		</PropertyGroup>
		<Message Importance="high" Condition="'$(_CanPublishAot)' != 'true'"
		         Text="GumPreview: skipping the Native AOT Preview variant - no MSVC linker found (install the Visual Studio 'Desktop development with C++' workload to build it). Preview uses the ReadyToRun build instead." />
		<Exec Condition="'$(_CanPublishAot)' == 'true'"
		      Command="$(_AotExecCommandPrefix)dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c Release -r $(_PreviewVariantRid) --self-contained true -p:PublishAot=true -p:SkipPreviewVariantPublish=true -o &quot;$(_HeadBinDir)Preview-Aot&quot;"
		      IgnoreStandardErrorWarningFormat="true" />
	</Target>

	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
	</ItemGroup>
	<ItemGroup>
		<!-- The selection-file format shared with the tool side (PreviewLauncher), linked rather than
		     referenced so this host stays free of the tool's plugin assemblies. -->
		<Compile Include="..\EditorTabPlugin.Core\Services\PreviewSelectionMessage.cs" Link="PreviewSelectionMessage.cs" />
		<Compile Include="..\EditorTabPlugin.Core\Services\PreviewSelectionFile.cs" Link="PreviewSelectionFile.cs" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\..\MonoGameGum\MonoGameGum.csproj" />
		<!-- Apos.Shapes-backed shape rendering (filled/rounded/shadowed Circle, Rectangle, Arc,
		     Polygon) - RectangleRuntime and friends render nothing without this (see Game1's
		     ShapeRenderer.Self.Initialize() call and the gum-samples skill's MonoGame host-init note). -->
		<ProjectReference Include="..\..\Runtimes\GumShapes\MonoGameGumShapes.csproj" />
	</ItemGroup>
</Project>
