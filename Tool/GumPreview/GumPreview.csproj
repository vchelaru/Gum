<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!--
			The runtime host the Gum tool's Preview button (issue #4697) launches: loads a project's
			.gumx directly (no codegen, no recompile) and shows the screen/component selected in the
			tool. Built alongside the tool and shipped next to the head executable in a Preview/ folder
			(see PreviewExecutableLocator in Tool/EditorTabPlugin.Core), not resolved from PATH.
		-->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<Nullable>enable</Nullable>
		<AssemblyName>GumPreview</AssemblyName>
	</PropertyGroup>
	<!--
		ReadyToRun precompiles native code ahead of time to reduce first-call JIT cost, same pattern
		as Gum.csproj (#4282) - startup latency is the whole point of Preview. This is the build used
		for .gumx (XML) projects, whose load path is a plain XmlSerializer that is not
		Native-AOT-safe (see IConvertProjectToJsonService). Only meaningful for a RID-specific
		publish; no effect on `dotnet build`. Skipped when publishing the Native AOT variant below
		(PublishReadyToRun and PublishAot are alternatives, not composable).
	-->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND '$(PublishAot)' != 'true'">
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>
	<!--
		Native AOT variant (issue #4706), published as a second `dotnet publish -p:PublishAot=true`
		invocation of this same csproj alongside the default ReadyToRun publish above - not a second
		project. Starts dramatically faster than ReadyToRun (no CoreCLR bootstrap, no JIT at all), but
		is only safe for .gumj (JSON) projects; PreviewExecutableLocator/PreviewLauncher pick this
		build over the ReadyToRun one based on GumProjectSave.IsJsonFormat, and fall back to
		ReadyToRun for a platform/package that has not published this variant. Proven trim-safe for
		Forms controls (RegisterFromFileFormRuntimeDefaults + BehaviorFormsPropertyApplier's
		reflection) by Tests/NativeAotSmoke.Harness.
	-->

	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<ProjectReference Include="..\..\MonoGameGum\MonoGameGum.csproj" />
		<!-- Apos.Shapes-backed shape rendering (filled/rounded/shadowed Circle, Rectangle, Arc,
		     Polygon) - RectangleRuntime and friends render nothing without this (see Game1's
		     ShapeRenderer.Self.Initialize() call and the gum-samples skill's MonoGame host-init note). -->
		<ProjectReference Include="..\..\Runtimes\GumShapes\MonoGameGumShapes.csproj" />
	</ItemGroup>
</Project>
