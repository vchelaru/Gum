<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<NoWarn>1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Gum.ProjectServices.Tests" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\Default\Standards\*.gutx" />
		<EmbeddedResource Include="Templates\Default\ExampleSpriteFrame.png" />
		<EmbeddedResource Include="Templates\FormsTemplate\**\*" Exclude="Templates\FormsTemplate\FontCache\**\*;Templates\FormsTemplate\Libraries\**\*" />
		<!-- Behaviors shared between FormsTemplate and Bubblegum (#4070) live in Templates\FormsBehaviors\,
		     linked into each theme's GumProject.gumx via BehaviorReference.SourcePath. FormsTemplateCreator
		     (gumcli new scaffolding) still expects them under the FormsTemplate.Behaviors.* resource prefix. -->
		<EmbeddedResource Include="Templates\FormsBehaviors\*.behx">
			<LogicalName>Gum.ProjectServices.Templates.FormsTemplate.Behaviors.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\..\Gum\Libraries\bmfont.exe" Link="Libraries\bmfont.exe" />
		<EmbeddedResource Include="..\..\Gum\Content\BmfcTemplate.bmfc" Link="Content\BmfcTemplate.bmfc" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="KernSmith" Version="0.21.0" />
		<PackageReference Include="KernSmith.Rasterizers.FreeType" Version="0.21.0" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup>
		<!-- Cross-platform purity guard; see Gum.Presentation.csproj for the rationale. -->
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="....BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<!-- ScreenshotDiffService (#4174) decodes/diffs rendered PNGs via the shared, dependency-free
		     PixelComparer rather than duplicating pixel-comparison logic. -->
		<ProjectReference Include="..\Gum.ImageDiff\Gum.ImageDiff.csproj" />
	</ItemGroup>

</Project>
