<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<NoWarn>1591</NoWarn>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(EmbedBmFont)' == 'false'">
		<!-- Own obj folder, so a build without bmfont.exe never reuses (or leaves behind) the other variant's
		     incremental output. -->
		<IntermediateOutputPath>obj/nobmfont/$(Configuration)/</IntermediateOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Gum.ProjectServices.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- Templates\Default\Standards\*.gutx is no longer embedded (#4676) — ProjectCreator now
		     builds the "Standards" folder straight from StandardElementsManager (the same source
		     the editor's File > New Project uses) instead of extracting a hand-maintained
		     duplicate. The on-disk files still exist, unembedded, as fixture data
		     Templates\Default\CliTemplate.gumx needs to load in GumJsonFixtureDifferentialTests. -->
		<EmbeddedResource Include="Templates\Default\ExampleSpriteFrame.png" />
		<EmbeddedResource Include="Templates\Default\Fonts\*" />
		<EmbeddedResource Include="Templates\FormsTemplate\**\*" Exclude="Templates\FormsTemplate\FontCache\**\*" />
		<!-- Behaviors shared between FormsTemplate and Bubblegum (#4070) live in Templates\FormsBehaviors\,
		     linked into each theme's GumProject.gumx via BehaviorReference.SourcePath. FormsTemplateCreator
		     (gumcli new scaffolding) still expects them under the FormsTemplate.Behaviors.* resource prefix. -->
		<EmbeddedResource Include="Templates\FormsBehaviors\*.behx">
			<LogicalName>Gum.ProjectServices.Templates.FormsTemplate.Behaviors.%(Filename)%(Extension)</LogicalName>
		</EmbeddedResource>
		<!-- bmfont.exe is legacy and runs only on Windows (FontGeneratorResolver switches BmFont to KernSmith
		     elsewhere), so a package for another OS must not carry its ~2 MB (#5457). The release workflow
		     passes -p:EmbedBmFont=false to the head, GumPreview and gumcli publishes for non-Windows RIDs; a
		     global property reaches this project, while RuntimeIdentifier itself does not (the SDK strips it
		     from library references). Any other build (dev, tests, the frozen WPF head) keeps it.
		     BmFontExeFileGenerator.IsEmbedded reports which. -->
		<EmbeddedResource Include="..\..\Gum\Libraries\bmfont.exe" Link="Libraries\bmfont.exe"
		                  Condition="'$(EmbedBmFont)' != 'false'" />
		<EmbeddedResource Include="..\..\Gum\Content\BmfcTemplate.bmfc" Link="Content\BmfcTemplate.bmfc" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
		<PackageReference Include="KernSmith" Version="0.21.0" />
		<PackageReference Include="KernSmith.Rasterizers.FreeType" Version="0.21.0" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.5" />
	</ItemGroup>

	<ItemGroup>
		<!-- Cross-platform purity guard; see Gum.Presentation.csproj for the rationale. -->
		<PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<AdditionalFiles Include="..\..\BannedSymbols.CrossPlatform.txt" Link="BannedSymbols.txt" />
		<AdditionalFiles Include="..\..\BannedSymbols.ToolUserData.txt" Link="BannedSymbols.ToolUserData.txt" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\GumCommon\GumCommon.csproj" />
		<!-- ScreenshotDiffService (#4174) decodes/diffs rendered PNGs via the shared, dependency-free
		     PixelComparer rather than duplicating pixel-comparison logic. -->
		<ProjectReference Include="..\Gum.ImageDiff\Gum.ImageDiff.csproj" />
	</ItemGroup>

</Project>
