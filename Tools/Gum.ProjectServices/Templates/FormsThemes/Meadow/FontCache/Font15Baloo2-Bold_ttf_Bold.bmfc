# AngelCode Bitmap Font Generator configuration file
fileVersion=1

# font settings
fontName=
fontFile=..\Fonts\Baloo2-Bold.ttf
fontSize=-15
isBold=1
isItalic=0
useSmoothing=1
aa=1
useHinting=1
scaleH=100
dontIncludeKerningPairs=0

# character alignment
paddingUp=0
paddingDown=0
paddingRight=0
paddingLeft=0
spacingHoriz=1
spacingVert=1
useFixedHeight=0
forceZero=0

# output file
outWidth=8192
outHeight=8192
fontDescFormat=0
textureFormat=png
fourChnlPacked=0
alphaChnl=0
redChnl=4
greenChnl=4
blueChnl=4
invA=0
invR=0
invG=0
invB=0

# outline
outlineThickness=0

# selected chars
chars=32-126,160-255,9632-9727,10003-10007

# output path
outputPath=Font15Baloo2-Bold_ttf_Bold

# kernsmith extensions
autofit=1
