<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/ScrollViewer</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>

    <!-- BevelInstance: Inset bevel + white fill, fills the whole control. Retro95's
         ScrollViewerVisual never varies fill between Enabled/Focused; no separate
         focus ring on this control (same as TextBox/PasswordBox). -->
    <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Inset</Value></Variable>
    <Variable Type="float" Name="BevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="BevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="BevelInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
    </VariableList>

    <Variable Type="bool" Name="ClipContainerInstance.ClipsChildren" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="bool" Name="ClipContainerInstance.HasEvents" SetsValue="true">
      <Value xsi:type="xsd:boolean">false</Value>
    </Variable>
    <Variable Type="float" Name="ClipContainerInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">-4</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ClipContainerInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="string" Name="ClipContainerInstance.Parent" SetsValue="true" />
    <Variable Type="float" Name="ClipContainerInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">-27</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ClipContainerInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="ClipContainerInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="float" Name="ClipContainerInstance.Y" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="ClipContainerInstance.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="ClipContainerInstance.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="string" Name="DefaultChildContainer" SetsValue="true">
      <Value xsi:type="xsd:string">InnerPanelInstance</Value>
    </Variable>

    <Variable Type="OrientationCategory" Name="HorizontalScrollBarInstance.OrientationCategoryState" SetsValue="true">
      <Value xsi:type="xsd:string">Horizontal</Value>
    </Variable>
    <Variable Type="string" Name="HorizontalScrollBarInstance.Parent" SetsValue="true" />
    <Variable Type="float" Name="HorizontalScrollBarInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">-24</Value>
    </Variable>
    <Variable Type="float" Name="HorizontalScrollBarInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="HorizontalScrollBarInstance.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="HorizontalScrollBarInstance.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="float" Name="HorizontalScrollBarInstance.Y" SetsValue="true">
      <Value xsi:type="xsd:float">-2</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="HorizontalScrollBarInstance.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="HorizontalScrollBarInstance.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">5</Value>
    </Variable>

    <Variable Type="ChildrenLayout" Name="InnerPanelInstance.ChildrenLayout" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="bool" Name="InnerPanelInstance.HasEvents" SetsValue="true">
      <Value xsi:type="xsd:boolean">false</Value>
    </Variable>
    <Variable Type="float" Name="InnerPanelInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="InnerPanelInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="string" Name="InnerPanelInstance.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">ClipContainerInstance</Value>
    </Variable>
    <Variable Type="float" Name="InnerPanelInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="InnerPanelInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>

    <Variable Type="ScrollBarVisibility" Name="ScrollBarVisibilityState" SetsValue="false" />
    <Variable Type="ScrollViewerCategory" Name="ScrollViewerCategoryState" SetsValue="true" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <Variable Type="float" Name="VerticalScrollBarInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">-24</Value>
    </Variable>
    <Variable Type="string" Name="VerticalScrollBarInstance.Parent" SetsValue="true" />
    <Variable Type="float" Name="VerticalScrollBarInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">-2</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="VerticalScrollBarInstance.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="VerticalScrollBarInstance.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="VerticalScrollBarInstance.Y" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="VerticalScrollBarInstance.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="VerticalScrollBarInstance.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
  </State>
  <Category>
    <Name>ScrollBarVisibility</Name>
    <State>
      <Name>NoScrollBar</Name>
      <Variable Type="float" Name="ClipContainerInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-4</Value>
      </Variable>
      <Variable Type="float" Name="ClipContainerInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-4</Value>
      </Variable>
      <Variable Type="bool" Name="HorizontalScrollBarInstance.Visible" SetsValue="true">
        <Value xsi:type="xsd:boolean">false</Value>
      </Variable>
      <Variable Type="float" Name="HorizontalScrollBarInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="float" Name="VerticalScrollBarInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="bool" Name="VerticalScrollBarInstance.Visible" SetsValue="true">
        <Value xsi:type="xsd:boolean">false</Value>
      </Variable>
    </State>
    <State>
      <Name>VerticalScrollVisible</Name>
      <Variable Type="float" Name="ClipContainerInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-4</Value>
      </Variable>
      <Variable Type="float" Name="ClipContainerInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-27</Value>
      </Variable>
      <Variable Type="bool" Name="HorizontalScrollBarInstance.Visible" Category="States and Visibility" SetsValue="true">
        <Value xsi:type="xsd:boolean">false</Value>
      </Variable>
      <Variable Type="float" Name="HorizontalScrollBarInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="float" Name="VerticalScrollBarInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">0</Value>
      </Variable>
      <Variable Type="bool" Name="VerticalScrollBarInstance.Visible" SetsValue="true">
        <Value xsi:type="xsd:boolean">true</Value>
      </Variable>
    </State>
    <State>
      <Name>HorizontalScrollVisible</Name>
      <Variable Type="float" Name="ClipContainerInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-27</Value>
      </Variable>
      <Variable Type="float" Name="ClipContainerInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-4</Value>
      </Variable>
      <Variable Type="bool" Name="HorizontalScrollBarInstance.Visible" Category="States and Visibility" SetsValue="true">
        <Value xsi:type="xsd:boolean">true</Value>
      </Variable>
      <Variable Type="float" Name="HorizontalScrollBarInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">0</Value>
      </Variable>
      <Variable Type="float" Name="VerticalScrollBarInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="bool" Name="VerticalScrollBarInstance.Visible" Category="States and Visibility" SetsValue="true">
        <Value xsi:type="xsd:boolean">false</Value>
      </Variable>
    </State>
    <State>
      <Name>BothScrollVisible</Name>
      <Variable Type="float" Name="ClipContainerInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-27</Value>
      </Variable>
      <Variable Type="float" Name="ClipContainerInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-27</Value>
      </Variable>
      <Variable Type="bool" Name="HorizontalScrollBarInstance.Visible" Category="States and Visibility" SetsValue="true">
        <Value xsi:type="xsd:boolean">true</Value>
      </Variable>
      <Variable Type="float" Name="HorizontalScrollBarInstance.Width" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="float" Name="VerticalScrollBarInstance.Height" SetsValue="true">
        <Value xsi:type="xsd:float">-24</Value>
      </Variable>
      <Variable Type="bool" Name="VerticalScrollBarInstance.Visible" Category="States and Visibility" SetsValue="true">
        <Value xsi:type="xsd:boolean">true</Value>
      </Variable>
    </State>
  </Category>
  <Category>
    <Name>ScrollViewerCategory</Name>
    <State>
      <Name>Enabled</Name>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
      </VariableList>
    </State>
    <State>
      <Name>Focused</Name>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
      </VariableList>
    </State>
  </Category>
  <Instance Name="BevelInstance" BaseType="Retro95/Elements/Bevel" />
  <Instance Name="VerticalScrollBarInstance" BaseType="Retro95/Controls/ScrollBar" />
  <Instance Name="HorizontalScrollBarInstance" BaseType="Retro95/Controls/ScrollBar" />
  <Instance Name="ClipContainerInstance" BaseType="Container" />
  <Instance Name="InnerPanelInstance" BaseType="Container" />
  <Behaviors>
    <ElementBehaviorReference>
      <BehaviorName>ScrollViewerBehavior</BehaviorName>
    </ElementBehaviorReference>
  </Behaviors>
  <VariablesHiddenFromInstances>
    <string>ContainedType</string>
    <string>ChildrenLayout</string>
    <string>ExposeChildrenEvents</string>
  </VariablesHiddenFromInstances>
</ComponentSave>
