<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/CheckBox</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Width" SetsValue="true"><Value xsi:type="xsd:float">128</Value></Variable>
    <Variable Type="float" Name="Height" SetsValue="true"><Value xsi:type="xsd:float">16</Value></Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="CheckBoxCategory" Name="CheckBoxCategoryState" SetsValue="false" />
    <Variable Type="bool" Name="IsChecked" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- BoxContainer: 13x13 box, left-aligned, vertically centered. HasEvents=false so
         clicks bubble to the CheckBox root (ContainerRuntime defaults HasEvents=true). -->
    <Variable Type="bool" Name="BoxContainer.HasEvents" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="float" Name="BoxContainer.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BoxContainer.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="BoxContainer.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="BoxContainer.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BoxContainer.YUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="VerticalAlignment" Name="BoxContainer.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BoxContainer.Width" SetsValue="true"><Value xsi:type="xsd:float">13</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BoxContainer.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="BoxContainer.Height" SetsValue="true"><Value xsi:type="xsd:float">13</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BoxContainer.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>

    <!-- BevelInstance: Inset bevel, fixed for the life of the control; only fill color
         and glyphs change per state (matches Retro95Bevel.AddTo(mode: Inset) never being
         re-SetMode'd in CheckBoxVisual). -->
    <Variable Type="string" Name="BevelInstance.Parent" SetsValue="true"><Value xsi:type="xsd:string">BoxContainer</Value></Variable>
    <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Inset</Value></Variable>
    <Variable Type="float" Name="BevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="BevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="BevelInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
    </VariableList>

    <!-- CheckGlyph: 17x17 overhang box centered on the 13x13 box (2px overhang each side) -->
    <Variable Type="string" Name="CheckGlyph.Parent" SetsValue="true"><Value xsi:type="xsd:string">BoxContainer</Value></Variable>
    <Variable Type="float" Name="CheckGlyph.X" SetsValue="true"><Value xsi:type="xsd:float">-2</Value></Variable>
    <Variable Type="PositionUnitType" Name="CheckGlyph.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="CheckGlyph.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="CheckGlyph.Y" SetsValue="true"><Value xsi:type="xsd:float">-2</Value></Variable>
    <Variable Type="PositionUnitType" Name="CheckGlyph.YUnits" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="VerticalAlignment" Name="CheckGlyph.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="CheckGlyph.Width" SetsValue="true"><Value xsi:type="xsd:float">17</Value></Variable>
    <Variable Type="DimensionUnitType" Name="CheckGlyph.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="CheckGlyph.Height" SetsValue="true"><Value xsi:type="xsd:float">17</Value></Variable>
    <Variable Type="DimensionUnitType" Name="CheckGlyph.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="CheckGlyph.HorizontalAlignment" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="VerticalAlignment" Name="CheckGlyph.VerticalAlignment" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable IsFont="true" Type="string" Name="CheckGlyph.Font" SetsValue="true"><Value xsi:type="xsd:string">Fonts/DejaVuSansMono.ttf</Value></Variable>
    <Variable Type="int" Name="CheckGlyph.FontSize" SetsValue="true"><Value xsi:type="xsd:int">12</Value></Variable>
    <Variable Type="string" Name="CheckGlyph.Text" SetsValue="true"><Value xsi:type="xsd:string">&#10003;</Value></Variable>
    <Variable Type="bool" Name="CheckGlyph.Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="int" Name="CheckGlyph.Red" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="CheckGlyph.Green" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="CheckGlyph.Blue" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>CheckGlyph.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>Color = Components/Retro95/Styles.Text.FillColor</string></Value>
    </VariableList>

    <!-- DashIndicator: 7x2 navy bar, centered, for the indeterminate state -->
    <Variable Type="string" Name="DashIndicator.Parent" SetsValue="true"><Value xsi:type="xsd:string">BoxContainer</Value></Variable>
    <Variable Type="float" Name="DashIndicator.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="DashIndicator.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="DashIndicator.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="DashIndicator.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="DashIndicator.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="DashIndicator.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="DashIndicator.Width" SetsValue="true"><Value xsi:type="xsd:float">7</Value></Variable>
    <Variable Type="DimensionUnitType" Name="DashIndicator.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="DashIndicator.Height" SetsValue="true"><Value xsi:type="xsd:float">2</Value></Variable>
    <Variable Type="DimensionUnitType" Name="DashIndicator.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="bool" Name="DashIndicator.IsFilled" SetsValue="true"><Value xsi:type="xsd:boolean">true</Value></Variable>
    <Variable Type="float" Name="DashIndicator.StrokeWidth" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="bool" Name="DashIndicator.Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="int" Name="DashIndicator.FillRed" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="DashIndicator.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="DashIndicator.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">128</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>DashIndicator.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.Selection.FillColor</string></Value>
    </VariableList>

    <!-- FocusRectInstance: hugs the label text, not the box (Win95 convention) -->
    <Variable Type="float" Name="FocusRectInstance.X" SetsValue="true"><Value xsi:type="xsd:float">17</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="FocusRectInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="FocusRectInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-15</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="bool" Name="FocusRectInstance.Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>

    <!-- TextInstance -->
    <Variable Type="float" Name="TextInstance.X" SetsValue="true"><Value xsi:type="xsd:float">19</Value></Variable>
    <Variable Type="PositionUnitType" Name="TextInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TextInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="TextInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="TextInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TextInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="TextInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-19</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TextInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="TextInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TextInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">4</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TextInstance.HorizontalAlignment" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TextInstance.VerticalAlignment" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="string" Name="TextInstance.Text" ExposedAsName="Text" SetsValue="true"><Value xsi:type="xsd:string">Label</Value></Variable>
    <Variable IsFont="true" Type="string" Name="TextInstance.Font" SetsValue="true"><Value xsi:type="xsd:string">Fonts/Nunito-Regular.ttf</Value></Variable>
    <Variable Type="int" Name="TextInstance.FontSize" SetsValue="true"><Value xsi:type="xsd:int">13</Value></Variable>
    <Variable Type="int" Name="TextInstance.Red" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="TextInstance.Green" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="TextInstance.Blue" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>TextInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value>
        <string>Color = Components/Retro95/Styles.Text.FillColor</string>
        <string>Font = Components/Retro95/Styles.Normal.Font</string>
        <string>FontSize = Components/Retro95/Styles.Normal.FontSize</string>
      </Value>
    </VariableList>
  </State>

  <Category>
    <Name>CheckBoxCategory</Name>

    <State>
      <Name>EnabledOff</Name>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
