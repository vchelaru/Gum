<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/SliderThumb</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Width" SetsValue="true"><Value xsi:type="xsd:float">12</Value></Variable>
    <Variable Type="DimensionUnitType" Name="WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="Height" SetsValue="true"><Value xsi:type="xsd:float">22</Value></Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="ButtonCategory" Name="ButtonCategoryState" SetsValue="false" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- BevelInstance: fills the thumb -->
    <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Raised</Value></Variable>
    <Variable Type="float" Name="BevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="BevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="BevelInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.Surface.FillColor</string></Value>
    </VariableList>

    <!-- FocusRectInstance: inset 2px, driven externally by Slider (ExposedAsName so the
         parent Slider.gucx can set ThumbInstance.ShowFocusRect directly) -->
    <Variable Type="float" Name="FocusRectInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="FocusRectInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="FocusRectInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="FocusRectInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="FocusRectInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-4</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="FocusRectInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">-4</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="bool" Name="FocusRectInstance.Visible" ExposedAsName="ShowFocusRect" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
  </State>

  <Category>
    <Name>ButtonCategory</Name>

    <State>
      <Name>Enabled</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Raised</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.Surface.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>Highlighted</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Raised</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.SurfaceHover.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>Pushed</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Sunken</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.Surface.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>Focused</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Raised</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.Surface.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>HighlightedFocused</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Raised</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">202</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.SurfaceHover.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>Disabled</Name>
      <!-- StatusPanel: single-tone bevel (inner ring matches fill), the "drained" Win95 look -->
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">StatusPanel</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.DisabledThumb.FillColor</string></Value>
      </VariableList>
    </State>

    <State>
      <Name>DisabledFocused</Name>
      <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">StatusPanel</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">168</Value></Variable>
      <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
        <Value><string>FillColor = Components/Retro95/Styles.DisabledThumb.FillColor</string></Value>
      </VariableList>
    </State>
  </Category>

  <Instance Name="BevelInstance" BaseType="Retro95/Elements/Bevel" />
  <Instance Name="FocusRectInstance" BaseType="Retro95/Elements/FocusRect" />
  <Behaviors>
    <ElementBehaviorReference>
      <BehaviorName>ButtonBehavior</BehaviorName>
    </ElementBehaviorReference>
  </Behaviors>
  <VariablesHiddenFromInstances>
    <string>ButtonCategoryState</string>
    <string>ContainedType</string>
    <string>ChildrenLayout</string>
    <string>ClipsChildren</string>
    <string>IsRenderTarget</string>
    <string>ExposeChildrenEvents</string>
  </VariablesHiddenFromInstances>
</ComponentSave>
