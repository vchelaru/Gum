<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/ScrollBar</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">18</Value>
    </Variable>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">128</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
    <Variable Type="OrientationCategory" Name="OrientationCategoryState" SetsValue="true" />
    <Variable Type="ScrollBarCategory" Name="ScrollBarCategoryState" SetsValue="false" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- UpButtonInstance: top (vertical) / left (horizontal) arrow -->
    <Variable Type="string" Name="UpButtonInstance.Text" SetsValue="true"><Value xsi:type="xsd:string">&#9650;</Value></Variable>
    <Variable Type="float" Name="UpButtonInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="UpButtonInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="UpButtonInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="UpButtonInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="UpButtonInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="VerticalAlignment" Name="UpButtonInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="UpButtonInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">18</Value></Variable>
    <Variable Type="DimensionUnitType" Name="UpButtonInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="UpButtonInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">18</Value></Variable>
    <Variable Type="DimensionUnitType" Name="UpButtonInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>

    <!-- DownButtonInstance: bottom (vertical) / right (horizontal) arrow -->
    <Variable Type="string" Name="DownButtonInstance.Text" SetsValue="true"><Value xsi:type="xsd:string">&#9660;</Value></Variable>
    <Variable Type="float" Name="DownButtonInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="DownButtonInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="DownButtonInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="DownButtonInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="DownButtonInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">5</Value></Variable>
    <Variable Type="VerticalAlignment" Name="DownButtonInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="DownButtonInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">18</Value></Variable>
    <Variable Type="DimensionUnitType" Name="DownButtonInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="DownButtonInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">18</Value></Variable>
    <Variable Type="DimensionUnitType" Name="DownButtonInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>

    <!-- TrackInstance: flat gray fill between the two buttons -->
    <Variable Type="float" Name="TrackInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="TrackInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TrackInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="TrackInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">18</Value></Variable>
    <Variable Type="PositionUnitType" Name="TrackInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TrackInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="TrackInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TrackInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="TrackInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">-36</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TrackInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>

    <!-- TrackFill: flat gray fill, sized to TrackInstance (a Container, per ScrollBarBehavior's
         contract, so it can't carry fill/stroke variables itself) -->
    <Variable Type="string" Name="TrackFill.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">TrackInstance</Value>
    </Variable>
    <Variable Type="float" Name="TrackFill.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="TrackFill.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TrackFill.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="TrackFill.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="TrackFill.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TrackFill.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="TrackFill.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TrackFill.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="TrackFill.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TrackFill.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="bool" Name="TrackFill.IsFilled" SetsValue="true"><Value xsi:type="xsd:boolean">true</Value></Variable>
    <Variable Type="float" Name="TrackFill.StrokeWidth" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="int" Name="TrackFill.FillRed" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <Variable Type="int" Name="TrackFill.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <Variable Type="int" Name="TrackFill.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">192</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>TrackFill.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.Surface.FillColor</string></Value>
    </VariableList>

    <!-- ThumbInstance: nested Button, raised bevel, 1px inset from the track -->
    <Variable Type="string" Name="ThumbInstance.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">TrackInstance</Value>
    </Variable>
    <Variable Type="string" Name="ThumbInstance.Text" SetsValue="true">
      <Value xsi:type="xsd:string"></Value>
    </Variable>
    <Variable Type="float" Name="ThumbInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="ThumbInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="ThumbInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="ThumbInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="ThumbInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="ThumbInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="ThumbInstance.Width" SetsValue="true">
      <Value xsi:type="xsd:float">-2</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ThumbInstance.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="float" Name="ThumbInstance.Height" SetsValue="true">
      <Value xsi:type="xsd:float">32</Value>
    </Variable>
    <Variable Type="DimensionUnitType" Name="ThumbInstance.HeightUnits" SetsValue="true">
      <Value xsi:type="xsd:int">0</Value>
    </Variable>
  </State>
