  <Instance Name="TrackInstance" BaseType="Container" />
  <Instance Name="TrackBevelInstance" BaseType="Retro95/Elements/Bevel" />
  <Instance Name="ThumbInstance" BaseType="Retro95/Controls/SliderThumb" />
  <Behaviors>
    <ElementBehaviorReference>
      <BehaviorName>SliderBehavior</BehaviorName>
    </ElementBehaviorReference>
  </Behaviors>
  <VariablesHiddenFromInstances>
    <string>SliderCategoryState</string>
    <string>ContainedType</string>
    <string>ChildrenLayout</string>
    <string>ClipsChildren</string>
    <string>IsRenderTarget</string>
    <string>ExposeChildrenEvents</string>
  </VariablesHiddenFromInstances>
