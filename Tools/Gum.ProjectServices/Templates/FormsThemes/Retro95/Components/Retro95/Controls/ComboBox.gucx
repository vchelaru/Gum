    <Variable Type="float" Name="DropdownBevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="DropdownBevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">4</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="DropdownBevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
