    <Variable Type="float" Name="IconInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="IconInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
