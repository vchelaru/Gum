<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/ComboBox</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">24</Value>
    </Variable>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">256</Value>
    </Variable>
    <Variable Type="ComboBoxCategory" Name="ComboBoxCategoryState" SetsValue="true">
      <Value xsi:type="xsd:string">Enabled</Value>
    </Variable>
    <Variable Type="string" Name="DefaultChildContainer" SetsValue="true">
      <Value xsi:type="xsd:string">ListBoxInstance</Value>
    </Variable>
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- FieldBevelInstance: Inset bevel + white fill, the text-entry field -->
    <Variable Type="BevelCategory" Name="FieldBevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Inset</Value></Variable>
    <Variable Type="float" Name="FieldBevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FieldBevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="FieldBevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="FieldBevelInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FieldBevelInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="FieldBevelInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="FieldBevelInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-18</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FieldBevelInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="FieldBevelInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FieldBevelInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="int" Name="FieldBevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="FieldBevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="FieldBevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>FieldBevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
    </VariableList>

    <!-- DropdownBevelInstance: Raised bevel button on the right, flips Sunken when pushed -->
