<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/RadioButton</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Width" SetsValue="true"><Value xsi:type="xsd:float">128</Value></Variable>
    <Variable Type="float" Name="Height" SetsValue="true"><Value xsi:type="xsd:float">16</Value></Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="RadioButtonCategory" Name="RadioButtonCategoryState" SetsValue="false" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- OuterCircle: fill + stroke merged onto one Circle instance (avoids the AA seam
         two independently-antialiased circles at identical bounds would produce). -->
    <Variable Type="float" Name="OuterCircle.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="OuterCircle.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="OuterCircle.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="OuterCircle.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="OuterCircle.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="OuterCircle.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="OuterCircle.Width" SetsValue="true"><Value xsi:type="xsd:float">13</Value></Variable>
    <Variable Type="DimensionUnitType" Name="OuterCircle.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="OuterCircle.Height" SetsValue="true"><Value xsi:type="xsd:float">13</Value></Variable>
    <Variable Type="DimensionUnitType" Name="OuterCircle.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="bool" Name="OuterCircle.IsFilled" SetsValue="true"><Value xsi:type="xsd:boolean">true</Value></Variable>
    <Variable Type="float" Name="OuterCircle.StrokeWidth" SetsValue="true"><Value xsi:type="xsd:float">1</Value></Variable>
    <Variable Type="DimensionUnitType" Name="OuterCircle.StrokeWidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="OuterCircle.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="OuterCircle.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="OuterCircle.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="OuterCircle.StrokeRed" SetsValue="true"><Value xsi:type="xsd:int">64</Value></Variable>
    <Variable Type="int" Name="OuterCircle.StrokeGreen" SetsValue="true"><Value xsi:type="xsd:int">64</Value></Variable>
    <Variable Type="int" Name="OuterCircle.StrokeBlue" SetsValue="true"><Value xsi:type="xsd:int">64</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>OuterCircle.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value>
        <string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string>
        <string>StrokeColor = Components/Retro95/Styles.ShadowOuter.FillColor</string>
      </Value>
    </VariableList>

    <!-- InnerDot: 5px black dot, centered, shown when selected -->
    <Variable Type="float" Name="InnerDot.X" SetsValue="true"><Value xsi:type="xsd:float">4</Value></Variable>
    <Variable Type="PositionUnitType" Name="InnerDot.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="InnerDot.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="InnerDot.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="InnerDot.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="InnerDot.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="InnerDot.Width" SetsValue="true"><Value xsi:type="xsd:float">5</Value></Variable>
    <Variable Type="DimensionUnitType" Name="InnerDot.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="InnerDot.Height" SetsValue="true"><Value xsi:type="xsd:float">5</Value></Variable>
    <Variable Type="DimensionUnitType" Name="InnerDot.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="bool" Name="InnerDot.IsFilled" SetsValue="true"><Value xsi:type="xsd:boolean">true</Value></Variable>
    <Variable Type="float" Name="InnerDot.StrokeWidth" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="bool" Name="InnerDot.Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="int" Name="InnerDot.FillRed" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="InnerDot.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="InnerDot.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>InnerDot.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.Text.FillColor</string></Value>
    </VariableList>

    <!-- FocusRectInstance: hugs the label text, not the circle (Win95 convention) -->
    <Variable Type="float" Name="FocusRectInstance.X" SetsValue="true"><Value xsi:type="xsd:float">17</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="FocusRectInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="FocusRectInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-15</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="bool" Name="FocusRectInstance.Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>

    <!-- TextInstance -->
    <Variable Type="float" Name="TextInstance.X" SetsValue="true"><Value xsi:type="xsd:float">19</Value></Variable>
    <Variable Type="PositionUnitType" Name="TextInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TextInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="TextInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="TextInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TextInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="TextInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">-19</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TextInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="TextInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="TextInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">4</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="TextInstance.HorizontalAlignment" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="VerticalAlignment" Name="TextInstance.VerticalAlignment" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="string" Name="TextInstance.Text" ExposedAsName="Text" SetsValue="true"><Value xsi:type="xsd:string">Label</Value></Variable>
    <Variable IsFont="true" Type="string" Name="TextInstance.Font" SetsValue="true"><Value xsi:type="xsd:string">Fonts/Nunito-Regular.ttf</Value></Variable>
    <Variable Type="int" Name="TextInstance.FontSize" SetsValue="true"><Value xsi:type="xsd:int">13</Value></Variable>
    <Variable Type="int" Name="TextInstance.Red" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="TextInstance.Green" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="TextInstance.Blue" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>TextInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value>
        <string>Color = Components/Retro95/Styles.Text.FillColor</string>
        <string>Font = Components/Retro95/Styles.Normal.Font</string>
        <string>FontSize = Components/Retro95/Styles.Normal.FontSize</string>
      </Value>
    </VariableList>
  </State>

