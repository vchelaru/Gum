    </Variable>

    <!-- VerticalScrollBarInstance: inset 2px from every side so it sits inside the
         bevel chrome instead of overlapping it. -->
    <Variable Type="string" Name="VerticalScrollBarInstance.Parent" SetsValue="true">
      <Value xsi:type="xsd:string">ClipAndScrollContainer</Value>
    </Variable>
    <Variable Type="bool" Name="VerticalScrollBarInstance.Visible" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="float" Name="VerticalScrollBarInstance.X" SetsValue="true">
      <Value xsi:type="xsd:float">-2</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="VerticalScrollBarInstance.XOrigin" SetsValue="true">
