    </Variable>
    <Variable Type="DimensionUnitType" Name="ClipContainerParent.WidthUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="float" Name="ClipContainerParent.X" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="ClipContainerParent.XOrigin" SetsValue="true">
