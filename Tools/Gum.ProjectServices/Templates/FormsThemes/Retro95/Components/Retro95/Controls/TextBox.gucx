<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Controls/TextBox</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Height" SetsValue="true"><Value xsi:type="xsd:float">24</Value></Variable>
    <Variable Type="float" Name="Width" SetsValue="true"><Value xsi:type="xsd:float">256</Value></Variable>
    <Variable Type="LineModeCategory" Name="LineModeCategoryState" SetsValue="false" />
    <Variable Type="TextBoxCategory" Name="TextBoxCategoryState" SetsValue="false" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- BevelInstance: Inset bevel + white fill, fills the whole control (never re-SetMode'd
         in Retro95TextInputDecoration; only fill color changes). -->
    <Variable Type="BevelCategory" Name="BevelInstance.BevelCategoryState" SetsValue="true"><Value xsi:type="xsd:string">Inset</Value></Variable>
    <Variable Type="float" Name="BevelInstance.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="BevelInstance.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="BevelInstance.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="BevelInstance.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="BevelInstance.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="BevelInstance.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillRed" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillGreen" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <Variable Type="int" Name="BevelInstance.FillBlue" SetsValue="true"><Value xsi:type="xsd:int">255</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>BevelInstance.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>FillColor = Components/Retro95/Styles.WhiteFill.FillColor</string></Value>
    </VariableList>

    <!-- ClipContainer: fills the bevel body (2px inset from the 2px bevel border, matching
         v3 default clipping around the text area) -->
    <Variable Type="bool" Name="ClipContainer.ClipsChildren" SetsValue="true"><Value xsi:type="xsd:boolean">true</Value></Variable>
    <Variable Type="bool" Name="ClipContainer.HasEvents" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="float" Name="ClipContainer.Height" SetsValue="true"><Value xsi:type="xsd:float">-4</Value></Variable>
    <Variable Type="DimensionUnitType" Name="ClipContainer.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="ClipContainer.Width" SetsValue="true"><Value xsi:type="xsd:float">-4</Value></Variable>
    <Variable Type="DimensionUnitType" Name="ClipContainer.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="ClipContainer.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="ClipContainer.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="ClipContainer.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="ClipContainer.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
