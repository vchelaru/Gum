    <Variable Type="VerticalAlignment" Name="ClipContainer.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="bool" Name="ClipsChildren" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>

