<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Retro95/Elements/FocusRect</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <!-- Fills the host by default; a consumer wanting an inset just sets this
         instance's own Width/Height/Units directly (universal instance properties,
         no exposure needed), mirroring Retro95DottedFocusRect's constructor `inset` param. -->
    <Variable Type="float" Name="Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="bool" Name="Visible" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="true" />

    <!-- FocusRectStroke: dashed 1px outline, always the theme's Text color; the code-only
         Retro95DottedFocusRect never varies stroke color per consumer, so it's not exposed. -->
    <Variable Type="float" Name="FocusRectStroke.X" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectStroke.XUnits" SetsValue="true"><Value xsi:type="xsd:int">6</Value></Variable>
    <Variable Type="HorizontalAlignment" Name="FocusRectStroke.XOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.Y" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="PositionUnitType" Name="FocusRectStroke.YUnits" SetsValue="true"><Value xsi:type="xsd:int">7</Value></Variable>
    <Variable Type="VerticalAlignment" Name="FocusRectStroke.YOrigin" SetsValue="true"><Value xsi:type="xsd:int">1</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.Width" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectStroke.WidthUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.Height" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectStroke.HeightUnits" SetsValue="true"><Value xsi:type="xsd:int">2</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.CornerRadius" SetsValue="true"><Value xsi:type="xsd:float">0</Value></Variable>
    <Variable Type="bool" Name="FocusRectStroke.IsFilled" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.StrokeWidth" SetsValue="true"><Value xsi:type="xsd:float">1</Value></Variable>
    <Variable Type="DimensionUnitType" Name="FocusRectStroke.StrokeWidthUnits" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.StrokeDashLength" SetsValue="true"><Value xsi:type="xsd:float">1</Value></Variable>
    <Variable Type="float" Name="FocusRectStroke.StrokeGapLength" SetsValue="true"><Value xsi:type="xsd:float">1</Value></Variable>
    <Variable Type="bool" Name="FocusRectStroke.IsAntialiased" SetsValue="true"><Value xsi:type="xsd:boolean">false</Value></Variable>
    <Variable Type="int" Name="FocusRectStroke.StrokeRed" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="FocusRectStroke.StrokeGreen" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <Variable Type="int" Name="FocusRectStroke.StrokeBlue" SetsValue="true"><Value xsi:type="xsd:int">0</Value></Variable>
    <VariableList xsi:type="VariableListSaveOfString"><Type>string</Type><Name>FocusRectStroke.VariableReferences</Name><Category>References</Category><IsFile>false</IsFile><IsHiddenInPropertyGrid>false</IsHiddenInPropertyGrid>
      <Value><string>StrokeColor = Components/Retro95/Styles.Text.FillColor</string></Value>
    </VariableList>
  </State>
  <Instance Name="FocusRectStroke" BaseType="Rectangle" />
  <Behaviors />
  <VariablesHiddenFromInstances>
    <string>ContainedType</string>
    <string>ChildrenLayout</string>
    <string>ClipsChildren</string>
    <string>IsRenderTarget</string>
    <string>ExposeChildrenEvents</string>
  </VariablesHiddenFromInstances>
</ComponentSave>
