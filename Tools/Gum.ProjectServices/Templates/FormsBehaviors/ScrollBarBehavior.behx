<?xml version="1.0" encoding="utf-8"?>
<BehaviorSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>ScrollBarBehavior</Name>
  <RequiredVariables />
  <FormsProperty Type="string" Name="ToolTip" />
  <FormsProperty Type="bool" Name="IsEnabled">
    <Value xsi:type="xsd:boolean">true</Value>
  </FormsProperty>
  <FormsProperty Type="double" Name="Minimum">
    <Value xsi:type="xsd:double">0</Value>
  </FormsProperty>
  <FormsProperty Type="double" Name="Maximum">
    <Value xsi:type="xsd:double">100</Value>
  </FormsProperty>
  <FormsProperty Type="double" Name="Value">
    <Value xsi:type="xsd:double">0</Value>
  </FormsProperty>
  <FormsProperty Type="double" Name="SmallChange">
    <Value xsi:type="xsd:double">10</Value>
    <Description>Step size for arrow buttons / mouse wheel.</Description>
  </FormsProperty>
  <FormsProperty Type="double?" Name="LargeChange">
    <Description>Step for track clicks. Empty follows the viewport size.</Description>
  </FormsProperty>
  <FormsProperty Type="Orientation" Name="Orientation">
    <Value xsi:type="xsd:string">Vertical</Value>
    <Description>Vertical places the buttons above and below the track; Horizontal places them left and right.</Description>
  </FormsProperty>
  <ToolOnlyVariableReference>OrientationCategoryState = Orientation == "Horizontal" ? "Horizontal" : "Vertical"</ToolOnlyVariableReference>
  <Category>
    <Name>ScrollBarCategory</Name>
  </Category>
  <Category>
    <Name>OrientationCategory</Name>
    <State>
      <Name>Vertical</Name>
    </State>
    <State>
      <Name>Horizontal</Name>
    </State>
  </Category>
  <RequiredInstances>
    <InstanceSave Name="ThumbInstance" BaseType="">
      <Behaviors>
        <BehaviorReference>
          <Name>ButtonBehavior</Name>
        </BehaviorReference>
      </Behaviors>
    </InstanceSave>
    <InstanceSave Name="TrackInstance" BaseType="Container">
      <Behaviors />
    </InstanceSave>
  </RequiredInstances>
  <RequiredAnimations />
  <DefaultImplementation>Controls/ScrollBar</DefaultImplementation>
</BehaviorSave>