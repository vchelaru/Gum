using Gum;
using Gum.Forms.Controls;
using Gum.GueDeriving;
using Gum.Wireframe;
{{HostUsings}}
using Raylib_cs;

const int screenWidth = 800;
const int screenHeight = 450;

Raylib.SetConfigFlags(ConfigFlags.ResizableWindow);
Raylib.InitWindow(screenWidth, screenHeight, "{{ProjectName}}");
Raylib.SetTargetFPS(60);

GumUI.Initialize("Content/GumProject/{{GumProjectFile}}");
GumUI.UseKeyboardDefaults();
GumUI.UseGamepadDefaults();
// The canvas grows and shrinks with the window, so the UI gets more room rather than scaling.
GumUI.EnableExpandToWindow();
{{InitLines}}
{{ScreenLines}}

while (!Raylib.WindowShouldClose())
{
    GumUI.Update(Raylib.GetTime());

    Raylib.BeginDrawing();
    Raylib.ClearBackground(Raylib_cs.Color.SkyBlue);
    GumUI.Draw();
    Raylib.EndDrawing();
}

Raylib.CloseWindow();

// A property rather than a top-level local, which would hide any GumUI that the project's other files declare (CS8801).
partial class Program
{
    static GumService GumUI => GumService.Default;
}
