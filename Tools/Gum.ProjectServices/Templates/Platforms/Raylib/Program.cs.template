using Gum;
using Gum.Wireframe;
{{HostUsings}}
using Raylib_cs;

const int screenWidth = 800;
const int screenHeight = 450;

Raylib.InitWindow(screenWidth, screenHeight, "{{ProjectName}}");
Raylib.SetTargetFPS(60);

// This tells Gum to use the entire screen
GraphicalUiElement.CanvasWidth = screenWidth;
GraphicalUiElement.CanvasHeight = screenHeight;

GumService gumUI = GumService.Default;

gumUI.Initialize("Content/GumProject/{{GumProjectFile}}");
{{InitLines}}
{{ScreenLines}}

while (!Raylib.WindowShouldClose())
{
    gumUI.Update(Raylib.GetTime());

    Raylib.BeginDrawing();
    Raylib.ClearBackground(Raylib_cs.Color.SkyBlue);
    gumUI.Draw();
    Raylib.EndDrawing();
}

Raylib.CloseWindow();
