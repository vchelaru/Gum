<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>{{RootNamespace}}</RootNamespace>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    {{GumReference}}
    <!-- Windowing.Sdl creates the window and its OpenGL context. Input.Sdl is what window.CreateInput()
         looks for at runtime, and without it that call throws NotSupportedException. -->
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Input.Sdl" Version="2.21.0" />
    <!-- Silk.NET 2.21.0 resolves Ultz.Native.SDL 2.30.1, whose macOS arm64 libSDL2 has an invalid code
         signature, so macOS kills the app at launch. Remove this once Silk.NET depends on a signed build. -->
    <PackageReference Include="Ultz.Native.SDL" Version="2.32.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
