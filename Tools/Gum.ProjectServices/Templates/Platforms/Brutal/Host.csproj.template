<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- WinExe in Release so no console window opens behind the game; Debug keeps Exe for console output. -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <!-- The BRUTAL packages target net10.0. Windows and Linux with Vulkan 1.3. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>{{RootNamespace}}</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    {{GumReference}}
    <PackageReference Include="Ahwoo.Brutal.Glfw" Version="2026.10.5" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.Brutal.ShaderC" Version="2026.10.3" />
    <PackageReference Include="SkiaGameRendering.Brutal" Version="0.21.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
