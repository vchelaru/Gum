using System;
using Gum;
using Gum.Forms.Controls;
using Gum.GueDeriving;
using Gum.Wireframe;
{{HostUsings}}
using Stride.CommunityToolkit.Engine;
using Stride.CommunityToolkit.Rendering.Compositing;
using Stride.Engine;

using Game game = new Game();

game.Run(start: Start);

void Start(Scene rootScene)
{
    // Stride draws through a GraphicsCompositor and a camera, so both must exist before Gum initializes.
    game.AddGraphicsCompositor().AddCleanUIStage();
    game.Add2DCamera();
    // Gum resizes its canvas to the window, so the UI gets more room rather than scaling.
    game.Window.AllowUserResizing = true;

    GumService GumUI = GumService.Default;

    GumUI.Initialize(game, "Content/GumProject/{{GumProjectFile}}");
    GumUI.UseKeyboardDefaults();
    GumUI.UseGamepadDefaults();
    {{InitLines}}
    {{ScreenLines}}

}
