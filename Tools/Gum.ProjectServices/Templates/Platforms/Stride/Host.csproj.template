<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- WinExe in Release so no console window opens behind the game; Debug keeps Exe for console output. -->
    <OutputType Condition="'$(Configuration)' == 'Release'">WinExe</OutputType>
    <!-- Gum.Stride renders on the GPU only. Stride's Windows default is Direct3D11, which Gum.Stride
         supports (with Direct3D12) only from net10.0-windows7.0; plain net10.0 supports Vulkan only. -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>{{RootNamespace}}</RootNamespace>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    {{GumReference}}
    <PackageReference Include="Stride.CommunityToolkit.Windows" Version="1.0.0-preview.66" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
