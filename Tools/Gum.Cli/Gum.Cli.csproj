<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<AssemblyName>gumcli</AssemblyName>

		<Version>2026.4.5.1</Version>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>gumcli</ToolCommandName>
		<PackageId>GumCli</PackageId>
		<Description>CLI for Gum UI projects — create projects, check errors, generate C# code</Description>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="gumcli.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="gumcli.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Gum.ProjectServices\Gum.ProjectServices.csproj" />
		<!-- GumExpressions wires Roslyn-based right-side evaluation for VariableReferences.
		     Without it, only simple dot-path lookups work; literals (X = 100) and expressions
		     (X = A + B) would silently fail to evaluate during `gumcli check-references` fix mode. -->
		<ProjectReference Include="..\..\Runtimes\GumExpressions\GumExpressions.csproj" />
		<!-- Each rendering backend compiles its own copy of RenderingLibrary (SystemManagers etc.)
		     into a separate assembly, so referencing all three here is fine: Gum.Cli never names those
		     types itself (each Gum.ProjectServices.* project talks to one backend), so there is no
		     CS0433. The state that IS shared process-wide (ObjectFinder.Self in GumCommon,
		     FileManager.RelativeDirectory, IGumService.Default) is safe only because each gumcli run
		     is a one-shot process that initializes a single backend (screenshot picks MonoGame or
		     Raylib, svg is always Skia). Do not host these services inside a process that already
		     has a project loaded (the Gum tool): GumService.Initialize(canvas, projectPath) reloads
		     the project into ObjectFinder.Self and would replace the live one. See issue #4723. -->
		<ProjectReference Include="..\Gum.ProjectServices.MonoGame\Gum.ProjectServices.MonoGame.csproj" />
		<ProjectReference Include="..\Gum.ProjectServices.Raylib\Gum.ProjectServices.Raylib.csproj" />
		<ProjectReference Include="..\Gum.ProjectServices.SkiaGum\Gum.ProjectServices.SkiaGum.csproj" />
	</ItemGroup>

</Project>
