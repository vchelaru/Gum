<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Holds Gum.Topten.RichTextKit, Gum's fork of Topten.RichTextKit with
         https://github.com/toptensoftware/RichTextKit/pull/114 (halo stroke-join fix). The same
         package is published on nuget.org for consumers; this copy lets the repo build before a
         re-publish lands. Remove once upstream releases the fix (#5499). -->
    <add key="gum-local" value="ThirdParty/nuget-local" />
  </packageSources>
</configuration>
