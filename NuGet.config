<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Vendored patched build of Topten.RichTextKit (fixes halo stroke-join spiking at acute
         glyph corners, https://github.com/toptensoftware/RichTextKit/pull/114). Remove this
         source and the ThirdParty/nuget-local package, and bump SkiaGum's PackageReference back
         to the real nuget.org version, once that PR merges and ships. -->
    <add key="gum-local" value="ThirdParty/nuget-local" />
  </packageSources>
</configuration>
