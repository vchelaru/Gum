<Project>
  <!-- Lets net10.0-windows tool/plugin projects compile on non-Windows OSes (NETSDK1100) by
       pulling Windows Desktop reference assemblies instead of failing outright. Compile-only:
       the WPF projects still only run on Windows. No-op on Windows itself, since NETSDK1100 never fires there. -->
  <PropertyGroup>
    <EnableWindowsTargeting Condition="'$(EnableWindowsTargeting)' == ''">true</EnableWindowsTargeting>
  </PropertyGroup>
  <!-- A banned-symbol hit (RS0030, from BannedSymbols.*.txt) fails the build. Only projects that
       reference Microsoft.CodeAnalysis.BannedApiAnalyzers can raise it. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>
  <!-- A build never produces a package: no project may set GeneratePackageOnBuild to true (a repo
       hygiene test fails if one does). The release workflow packs with an explicit `dotnet pack`.
       Packing on build wrote a .nupkg on every build and forced consumers building Gum from source
       to pass AdditionalProperties="GeneratePackageOnBuild=false" on their references, which
       builds each shared library twice in parallel into one obj folder (#6436). -->
  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
