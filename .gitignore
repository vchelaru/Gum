# Ignore the DIST folder so that the RELEASE automation in github actions doesn't try to include the dist/gum.zip every time we release
dist/
**/settings.local.json

# Windows NUL file artifact (created by incorrect output redirection)
nul
# XNB test harnesses (not needed in repo, used for local verification only)
Runtimes/GumShapes/XnbTest/

# Test result artifacts from `dotnet test --logger trx` (regenerated every run)
[Tt]est[Rr]esult*/

/.claude/designs
*.setj

# Temp folder for draft/scratch files (e.g. release notes drafts)
/temp/*
!/temp/.gitkeep
/.claude/worktrees
/.claude/tmp

# Python bytecode (HtmlToGum fidelity scripts, etc.)
__pycache__/
*.py[cod]

# Node deps (HtmlToGum converter + fidelity; install locally via npm)
node_modules/

# HtmlToGum local outputs / scratch (regenerated by convert / site-fidelity / demos)
Tool/HtmlToGum/.out/
Tool/HtmlToGum/.regress/
Tool/HtmlToGum/.site-fidelity/
Tool/HtmlToGum/.bookmark-fidelity/
Tool/HtmlToGum/*.log
Tool/HtmlToGum/**/*.log
Tool/HtmlToGum/HtmlToGum-SpaceJam-Demo.html
# One-off fidelity debug probes (not harness API)
Tool/HtmlToGum/fidelity/_probe*
Tool/HtmlToGum/fidelity/_tl_*
# Local bookmark seed list (may contain personal URLs)
Tool/HtmlToGum/fidelity/seeds.json

# Keep package-lock.json under converter/ and fidelity/ — those are source, not build output.
